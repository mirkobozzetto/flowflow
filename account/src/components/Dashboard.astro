---
import {
  type AccountData,
  fmtDate,
  fmtDateTime,
  type Me,
  shortId,
} from "../lib/api";
import { useTranslations } from "../lib/i18n";
import Avatar from "./Avatar.astro";
import BrandIcon from "./BrandIcon.astro";

interface Props {
  lang: string;
  me: Me;
  data: AccountData;
}

const { lang, me, data } = Astro.props;
const t = useTranslations(lang, "account");
const n = t<Record<string, string>>("nav");

const panes = [
  { key: "overview", label: n.overview },
  { key: "devices", label: n.devices },
  { key: "services", label: n.services },
  { key: "billing", label: n.billing },
  { key: "security", label: n.security },
] as const;

const meName = me.display_name ?? me.email;
const plan = data.plans[0] ?? null;
const planLabel = plan
  ? plan.plan.charAt(0).toUpperCase() + plan.plan.slice(1)
  : t("overview.free");
const pendingRequests = data.requests.filter((r) => r.status === "pending");

const brandFor = (provider: string): "sheets" | "gmail" | "calendar" | null => {
  if (provider.includes("sheet")) return "sheets";
  if (provider.includes("gmail") || provider.includes("mail")) return "gmail";
  if (provider.includes("calendar")) return "calendar";
  return null;
};

const DEVICE_CAP = 3;
const freeSlots = Math.max(0, DEVICE_CAP - data.devices.length);
---

<div class="b-app">
  <aside class="b-side">
    <div class="sb">
      <img src="/logo.png" alt="" width="26" height="26" />
      FlowFlow
    </div>
    {
      panes.map((p, i) => (
        <>
          {p.key === "devices" && <div class="grp">{n.groupAccount}</div>}
          {p.key === "billing" && <div class="grp">{n.groupSettings}</div>}
          <button
            class={`b-item${i === 0 ? " on" : ""}`}
            type="button"
            data-pane={p.key}
          >
            {p.label}
          </button>
        </>
      ))
    }
    <div class="me">
      <Avatar name={meName} size={34} />
      <div><b>{meName}</b><small>{me.email}</small></div>
    </div>
  </aside>

  <div>
    <div class="b-pane on" data-pane="overview">
      <div class="b-ph"><h3>{n.overview}</h3></div>
      {
        data.linked ? (
          <div class="b-cards">
            <div class="b-c">
              <h4>
                <span class="t">{t("overview.devices")}</span>
                <span class="b-st">
                  {data.devices.length} / {DEVICE_CAP}
                </span>
              </h4>
              {data.devices.map((d) => (
                <div class="b-row">
                  <span class="b-dot" />
                  <div class="g">
                    <b>{shortId(d.device_id)}</b>
                    <small>
                      {t("devices.lastSeen")}{" "}
                      {d.last_seen
                        ? fmtDateTime(d.last_seen, lang)
                        : t("devices.never")}
                    </small>
                  </div>
                </div>
              ))}
            </div>

            <div class="b-c">
              <h4>
                <span class="t">{t("overview.billing")}</span>
                <span class="b-st">{planLabel}</span>
              </h4>
              <p class="b-big">
                {plan ? t("overview.noLimit") : t("billing.noPlan")}
              </p>
              {plan && (
                <div class="b-kv">
                  <span class="k">{t("overview.origin")}</span>
                  <span class="v">{t("overview.granted")}</span>
                </div>
              )}
            </div>

            <div class="b-c">
              <h4>
                <span class="t">{t("overview.services")}</span>
              </h4>
              {data.connections.length === 0 && (
                <div class="b-kv">
                  <span class="k">{t("services.none")}</span>
                </div>
              )}
              {data.connections.slice(0, 4).map((c) => (
                <div class="b-kv">
                  <span class="k">{c.provider}</span>
                  <span class="v">{t("overview.active")}</span>
                </div>
              ))}
            </div>

            <div class="b-c">
              <h4>
                <span class="t">{t("overview.requests")}</span>
                {pendingRequests.length > 0 && (
                  <span class="b-st">{pendingRequests.length}</span>
                )}
              </h4>
              {data.requests.length === 0 && (
                <div class="b-kv">
                  <span class="k">{t("overview.noRequests")}</span>
                </div>
              )}
              {data.requests.slice(0, 4).map((r) => (
                <div class="b-kv">
                  <span class="k">{r.item}</span>
                  <span class="v">{t(`billing.${r.status}`) ?? r.status}</span>
                </div>
              ))}
            </div>
          </div>
        ) : (
          <div class="b-cards">
            <div class="b-c wide">
              <div class="b-empty">
                <b>{t("overview.empty")}</b>
                {t("overview.emptyLead")}
              </div>
            </div>
          </div>
        )
      }
    </div>

    <div class="b-pane" data-pane="devices">
      <div class="b-ph">
        <h3>{n.devices}</h3>
        <span class="b-st sp">{data.devices.length} / {DEVICE_CAP}</span>
      </div>
      <div class="b-cards">
        <div class="b-c wide">
          {
            data.devices.length === 0 && (
              <div class="b-empty">
                <b>{t("devices.none")}</b>
                {t("overview.emptyLead")}
              </div>
            )
          }
          {
            data.devices.map((d) => (
              <div class="b-row">
                <span class="b-dot" />
                <div class="g">
                  <b>{shortId(d.device_id)}</b>
                  <small>
                    {t("devices.paired")} {fmtDate(d.created_at, lang)}
                  </small>
                </div>
                <span class="r">
                  {d.last_seen
                    ? fmtDateTime(d.last_seen, lang)
                    : t("devices.never")}
                </span>
              </div>
            ))
          }
          {
            freeSlots > 0 && (
              <div class="b-row">
                <span class="b-dot idle" />
                <div class="g text-stone-400">
                  <b>{t("devices.free")}</b>
                  <small>{t("devices.qr")}</small>
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>

    <div class="b-pane" data-pane="services">
      <div class="b-ph"><h3>{n.services}</h3></div>
      <div class="b-cards">
        <div class="b-c wide">
          {
            data.connections.length === 0 && (
              <div class="b-empty">
                <b>{t("services.none")}</b>
              </div>
            )
          }
          {
            data.connections.map((c) => (
              <div class="b-row">
                {brandFor(c.provider) ? (
                  <span class="b-svc">
                    <BrandIcon name={brandFor(c.provider)} />
                  </span>
                ) : (
                  <span class="b-dot" />
                )}
                <div class="g">
                  <b>{c.provider}</b>
                  <small>
                    {t("services.device")} {shortId(c.device_id)}
                    {c.scopes ? ` · ${c.scopes}` : ""}
                  </small>
                </div>
                <span class="r">
                  {c.access_expires_at
                    ? `${t("services.expires")} ${fmtDate(c.access_expires_at, lang)}`
                    : t("services.active")}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="b-pane" data-pane="billing">
      <div class="b-ph"><h3>{n.billing}</h3></div>
      <div class="b-cards">
        {
          data.plans.length === 0 && (
            <div class="b-c wide">
              <div class="b-empty">
                <b>{t("billing.noPlan")}</b>
              </div>
            </div>
          )
        }
        {
          data.plans.map((e, i) => (
            <div class="b-c">
              <h4>
                <span class="t">{t("billing.plan")}</span>
                <span class="b-st">
                  {e.plan.charAt(0).toUpperCase() + e.plan.slice(1)}
                </span>
              </h4>
              <div class="b-kv">
                <span class="k">{t("billing.status")}</span>
                <span class="v">{e.status}</span>
              </div>
              <div class="b-kv">
                <span class="k">{t("billing.due")}</span>
                <span class="v">
                  {e.expires_at
                    ? fmtDate(e.expires_at, lang)
                    : t("billing.none")}
                </span>
              </div>
              {i === 0 && data.items.length > 0 && (
                <div class="b-kv">
                  <span class="k">{t("billing.items")}</span>
                  <span class="v">{data.items.length}</span>
                </div>
              )}
            </div>
          ))
        }
        {
          data.requests.length > 0 && (
            <div class="b-c">
              <h4>
                <span class="t">{t("billing.requests")}</span>
              </h4>
              {data.requests.map((r) => (
                <div class="b-kv">
                  <span class="k">{r.item}</span>
                  <span class="v">
                    {t(`billing.${r.status}`) ?? r.status}
                    {r.decided_at ? ` · ${fmtDate(r.decided_at, lang)}` : ""}
                  </span>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <div class="b-pane" data-pane="security">
      <div class="b-ph"><h3>{n.security}</h3></div>
      <div class="b-cards">
        <div class="b-c wide">
          <h4><span class="t">{t("security.recent")}</span></h4>
          {
            data.loginEvents.length === 0 && (
              <div class="b-kv">
                <span class="k">{t("security.none")}</span>
              </div>
            )
          }
          {
            data.loginEvents.slice(0, 8).map((e) => (
              <div class="b-kv">
                <span class="k">{fmtDateTime(e.at, lang)}</span>
                <span class="v">
                  {e.kind === "register"
                    ? t("security.register")
                    : t("security.signin")}
                </span>
              </div>
            ))
          }
        </div>
        <div class="b-c wide">
          <div class="b-row">
            <div class="g">
              <b>{meName}</b><small>{me.email}</small>
            </div>
            <button class="b-btn" type="button" id="sign-out"
              >{t("auth.signOut")}</button
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import "../scripts/dashboard.ts";
  import "../scripts/session.ts";
</script>
