---
import { type AccountData, fmtDate, fmtDateTime, type Me, type ProfileData } from "../lib/api";
import { localizePath, useTranslations } from "../lib/i18n";
import Avatar from "./Avatar.astro";
import Profile from "./Profile.astro";
interface Props { lang: string; me: Me; data: AccountData; profile: ProfileData; }
const { lang, me, data, profile } = Astro.props;
const t = useTranslations(lang, "account");
const meName = profile.display_name?.value ?? me.display_name ?? me.email;
const access = data.onboarding;
const panes = [
  { key: "overview", label: t("home.title") },
  { key: "billing", label: t("nav.billing") },
  { key: "security", label: t("nav.security") },
];
---
<div class="b-app account-home">
  <aside class="b-side">
    <div class="sb"><img src="/logo.png" alt="" width="26" height="26" />FlowFlow</div>
    <nav class="account-nav" aria-label={t("home.navigation")}>
      {panes.map((pane, i) => <button class={`b-item${i === 0 ? " on" : ""}`} type="button" data-pane={pane.key} aria-current={i === 0 ? "page" : undefined}>{pane.label}</button>)}
    </nav>
    <div class="me"><Avatar name={meName} size={34} photo={true} /><div><b>{meName}</b><small>{me.email}</small></div></div>
  </aside>
  <div>
    <section class="b-pane on" data-pane="overview">
      <div class="b-ph"><h1>{t("home.title")}</h1>{access?.premium && <span class="account-premium">{t("overview.premium")}</span>}</div>
      {access && (!access.email_verified || !access.linked) && <p class="account-notice"><a href={localizePath("/onboarding", lang)}>{t("home.finishSetup")}</a></p>}
      <div class="account-grid">
        <div class="account-profile"><Profile lang={lang} me={me} profile={profile} /></div>
        <div class="account-aside">
          <section class="b-c">
            <h2>{t("nav.devices")}</h2>
            {!data.devicesAvailable ? <p role="status" class="b-note">{t("home.unavailable")}</p> : data.devices.length === 0 ? <p class="b-note">{t("devices.none")}</p> : data.devices.map((device) => <div class="b-row">
              {/\b(?:ios|iphone|android|phone|mobile)\b/i.test(device.name ?? "") ? (
                <svg class="account-device-icon" data-device-icon="phone" width="32" height="32" viewBox="0 0 64 64" fill="none" aria-hidden="true"><rect x="18" y="6" width="28" height="52" rx="5" stroke="currentColor" stroke-width="3"/><path d="M28 12h8M30 51h4" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
              ) : (
                <svg class="account-device-icon" width="32" height="32" viewBox="0 0 64 64" fill="none" aria-hidden="true"><rect x="10" y="12" width="44" height="32" rx="4" stroke="currentColor" stroke-width="3"/><path d="M24 53h16M32 44v9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
              )}
              <div class="g"><b>{device.name?.trim() || t("home.unnamedDevice")}</b><small>{t("home.lastActivity")} {device.last_seen ? fmtDateTime(device.last_seen, lang) : t("home.activityUnknown")}</small></div>
            </div>)}
            <p class="b-note">{t("home.deviceNamesHint")}</p>
            <a class="b-btn account-link" href={localizePath("/link", lang)}>{t("home.linkDevice")}</a>
          </section>
          {data.collaborators === null ? <section class="b-c"><h2>{t("home.collaborators")}</h2><p class="b-note" role="status">{t("home.unavailable")}</p></section> : data.collaborators.map((space) => <section class="b-c">
            <h2>{t("home.collaborators")}</h2><p class="b-note">{space.name}</p>
            {space.members.map((member, index) => <div class="b-row">
              <span class="account-person-photo">
                <span>{member.name?.trim().slice(0, 1).toUpperCase() || String(index + 1)}</span>
                {member.is_agent && member.name?.trim().toLowerCase() === "hermes" ? <img src="/hermes-agent.png" alt="" /> : member.has_avatar && <img src={`/v1/me/collaborators/${encodeURIComponent(space.id)}/${encodeURIComponent(member.id)}/avatar`} alt="" loading="lazy" onerror="this.remove()" />}
              </span>
              <div class="g"><b>{member.name?.trim() || `${t("home.collaborator")} ${index + 1}`}</b><small>{member.is_agent ? t("home.agentAccess") : t("home.collaborator")}</small></div>
            </div>)}
          </section>)}
        </div>
      </div>
    </section>
    <section class="b-pane" data-pane="billing">
      <div class="b-ph"><h1>{t("nav.billing")}</h1></div>
      <div class="b-c">
        {!access ? <p role="status">{t("home.unavailable")}</p> : <>
          <h2 class="account-plan-title">{access.premium ? t("overview.premium") : t(`onboarding.premium_${access.premium_status}`)}</h2>
          <p class="b-note">{access.premium ? t("home.premiumDescription") : t("onboarding.premiumHint")}</p>
          {access.premium_expires_at && <div class="b-kv"><span class="k">{t("billing.due")}</span><span class="v">{fmtDate(access.premium_expires_at, lang)}</span></div>}
          {!access.premium && <>
            {access.request && <p class="b-note">{t(`onboarding.request_${access.request.status}`)}</p>}
            <a class="b-btn pri account-link" href={localizePath("/onboarding", lang)}>{access.request?.status === "pending" ? t("home.followRequest") : t("onboarding.requestPremium")}</a>
          </>}
        </>}
      </div>
    </section>
    <section class="b-pane" data-pane="security">
      <div class="b-ph"><h1>{t("nav.security")}</h1></div>
      <div class="b-cards">
        <div class="b-c wide"><h2>{t("security.recent")}</h2>
          {!data.loginsAvailable ? <p class="b-note">{t("home.unavailable")}</p> : data.loginEvents.length === 0 ? <p class="b-note">{t("security.none")}</p> : data.loginEvents.slice(0, 8).map((event) => <div class="b-kv"><span class="k">{fmtDateTime(event.at, lang)}</span><span class="v">{t(event.kind === "register" ? "security.register" : "security.signin")}</span></div>)}
        </div>
        <div class="b-c wide"><div class="b-row"><div class="g"><b>{meName}</b><small>{me.email}</small></div><button class="b-btn" type="button" id="sign-out">{t("auth.signOut")}</button></div></div>
      </div>
    </section>
  </div>
</div>
<script>
  import "../scripts/dashboard.ts";
  import "../scripts/session.ts";
</script>
