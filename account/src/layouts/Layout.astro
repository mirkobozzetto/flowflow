---
import "../styles/global.css";
import { getMeta } from "../i18n/ui";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const m = getMeta(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{m.title}</title>
    <meta name="description" content={m.description} />
    <meta name="robots" content="noindex" />
    <link
      rel="preload"
      href="/fonts/clash-grotesk-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/clash-grotesk-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-serif-italic-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />
  </body>
</html>
