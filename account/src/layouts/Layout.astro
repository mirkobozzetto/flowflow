---
import "../styles/global.css";
import { getMeta } from "../i18n/ui";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const m = getMeta(lang);
const languageLink = (choice: string) => {
  const params = new URLSearchParams(Astro.url.search);
  params.set("lang", choice);
  return `${Astro.url.pathname}?${params}`;
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{m.title}</title>
    <meta name="description" content={m.description} />
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="no-referrer" />
    <link
      rel="preload"
      href="/fonts/clash-grotesk-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/clash-grotesk-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-serif-italic-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <nav class="account-language container" aria-label={lang === "fr" ? "Langue" : "Language"}>
      <a href={languageLink("fr")} lang="fr" aria-current={lang === "fr" ? "true" : undefined}>Français</a>
      <span aria-hidden="true"> / </span>
      <a href={languageLink("en")} lang="en" aria-current={lang === "en" ? "true" : undefined}>English</a>
    </nav>
    <slot />
  </body>
</html>
