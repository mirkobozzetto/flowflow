{
  "_comment": "RFC 0012 T00 conformance corpus. Identical bytes in marketplace-flowflow and flowflow; each repo replays it through its own governance::gate / Chain::validate in cargo test. Any divergence between the backend gate and the device gate fails an ordinary test. Pins the per-resource read_before_write reconciliation (the drift Rev-1/2 found), every Decision branch, and the FSM structural validation. A call may carry optional `columns` (-> ProposedCall::with_columns) and a vector may carry optional `run_seed` (steps/elapsed_seconds/tool_calls -> RunState) so the run-stateful branches are reachable.",
  "connector_manifest": {
    "connector": "google-sheets",
    "type": "tabular_store",
    "server": "ghcr.io/klavis-ai/google-sheets-mcp-server",
    "mcp_prefix": "google_sheets_",
    "provides": [
      "search",
      "read",
      "create",
      "update"
    ],
    "tools": [
      {
        "tool": "google_sheets_list_spreadsheets",
        "resource": "spreadsheet",
        "action": "search",
        "risk": "read_only"
      },
      {
        "tool": "google_sheets_get_spreadsheet",
        "resource": "spreadsheet",
        "action": "read",
        "risk": "read_only"
      },
      {
        "tool": "google_sheets_write_to_cell",
        "resource": "cell",
        "action": "update",
        "risk": "read_write"
      },
      {
        "tool": "google_sheets_wipe",
        "resource": "cell",
        "action": "update",
        "risk": "destructive"
      }
    ]
  },
