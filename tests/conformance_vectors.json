  "chain_vectors": [
    {
      "name": "linear_crm_sync_chain_valid",
      "chain": {
        "initial": "find",
        "states": {
          "find": {
            "allowed_tools": [
              "google_sheets_list_spreadsheets"
            ],
            "on_done": "read"
          },
          "read": {
            "allowed_tools": [
              "google_sheets_get_spreadsheet"
            ],
            "on_done": "act"
          },
          "act": {
            "allowed_tools": [
              "google_sheets_write_to_cell"
            ],
            "guard": "read_before_write",
            "on_done": "answer"
          },
          "answer": {
            "terminal": true
          }
        }
      },
      "expect": "ok"
    },
    {
      "name": "unreachable_state_rejected",
      "chain": {
        "initial": "find",
        "states": {
          "find": {
            "allowed_tools": [
              "google_sheets_list_spreadsheets"
            ],
            "on_done": "answer"
          },
          "answer": {
            "terminal": true
          },
          "orphan": {
            "allowed_tools": [
              "google_sheets_get_spreadsheet"
            ],
            "on_done": "answer"
          }
        }
      },
      "expect": "err"
    },
