const generic = new Set(["calendar", "reminders", "email", "marketplace"]);

function iconMarkup(slug: string): string {
  const inner = icons[slug] ?? "";
  if (generic.has(slug)) {
    return `<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0">${inner}</svg>`;
  }
  return inner;
}
---

<div class="connectors reveal mt-14">
  <div class="lbl mb-4 text-[12px] font-semibold uppercase tracking-widest text-stone-500">{label}</div>
  <div class="chips flex flex-wrap gap-2.25">
    {
      connectors.map((c) => (
        <span class="chip inline-flex items-center gap-2 rounded-[99px] border border-[#36302b] bg-(--ink-2) px-4 py-2.25 text-[13.5px] font-medium text-stone-300">
          <span
            class={`brand inline-flex items-center ${c.live ? "text-[#34c759]" : "text-orange-bright"}`}
            set:html={iconMarkup(c.icon)}
          />
          <span set:text={c.name} />
          {!c.live && <span class="dot-soon h-1.5 w-1.5 rounded-[99px] bg-orange-bright" />}
        </span>
      ))
    }
  </div>
</div>

<style>
  .dot-soon {
    animation: pulseSoft 1.6s ease-in-out infinite;
  }
  @keyframes pulseSoft {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot-soon {
      animation: none;
    }
  }
</style>
