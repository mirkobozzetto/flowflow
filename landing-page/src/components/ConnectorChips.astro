---
import BrandIcon from "./beta/BrandIcon.astro";

interface Connector {
  name: string;
  icon?: string;
  logo?: string;
}

interface Props {
  label: string;
  connectors: Connector[];
  variant?: "wrap" | "grid" | "tight" | "logos";
}

const { label, connectors, variant = "wrap" } = Astro.props;

const BRANDS = ["sheets", "gmail", "calendar", "drive", "docs"] as const;

type BrandName = (typeof BRANDS)[number];

const isBrand = (icon: string): icon is BrandName =>
  (BRANDS as readonly string[]).includes(icon);

const glyphs: Record<string, { color: string; path: string }> = {
  github: {
    color: "#181717",
    path: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
};
---

<div class="mt-10">
  <p class="lbl">{label}</p>
  <ul class="chips" data-variant={variant}>
    {
      connectors.map((c) => (
        <li title={c.name}>
          {c.logo ? (
            <img src={c.logo} alt="" width="19" height="19" />
          ) : isBrand(c.icon ?? "") ? (
            <BrandIcon name={c.icon as BrandName} />
          ) : (
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              fill={glyphs[c.icon ?? ""]?.color}
            >
              <path d={glyphs[c.icon ?? ""]?.path} />
            </svg>
          )}
          <span>{c.name}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lbl {
    margin-bottom: 12px;
    font-size: 17px;
    font-weight: 700;
    color: white;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 42px;
    padding: 0 16px 0 13px;
    border-radius: 12px;
    background: var(--paper-button);
    box-shadow: var(--paper-edge);
    color: black;
    font-size: 14.5px;
    font-weight: 600;
  }

  li svg,
  li img {
    width: 19px;
    height: 19px;
  }

  [data-variant="grid"] {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 640px) {
    [data-variant="grid"] {
      grid-template-columns: repeat(2, 1fr);
    }

    [data-variant="grid"] li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  [data-variant="tight"] {
    flex-wrap: nowrap;
    gap: 6px;
  }

  [data-variant="tight"] li {
    gap: 6px;
    min-height: 36px;
    padding: 0 10px 0 8px;
    font-size: 12.5px;
    white-space: nowrap;
  }

  [data-variant="logos"] li {
    justify-content: center;
    width: 52px;
    height: 52px;
    padding: 0;
  }

  [data-variant="logos"] li :global(svg) {
    width: 24px;
    height: 24px;
  }

  [data-variant="logos"] span {
    display: none;
  }
</style>
