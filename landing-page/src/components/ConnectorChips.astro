---

<div class="mt-10">
  <p class="lbl">{label}</p>
  <ul>
    {
      connectors.map((c) => (
        <li>
          {isBrand(c.icon) ? (
            <BrandIcon name={c.icon} />
          ) : (
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              fill={glyphs[c.icon]?.color}
            >
              <path d={glyphs[c.icon]?.path} />
            </svg>
          )}
          {c.name}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lbl {
    margin-bottom: 12px;
    font-size: 17px;
    font-weight: 700;
    color: white;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 42px;
    padding: 0 16px 0 13px;
    border-radius: 12px;
    background: white;
    color: black;
    font-size: 14.5px;
    font-weight: 600;
    box-shadow:
      inset 0 -1px 0 rgba(0, 0, 0, 0.06),
      0 1px 2px rgba(0, 0, 0, 0.12);
  }

  li svg {
    width: 19px;
    height: 19px;
  }
</style>
