---
import { section } from "../lib/i18n";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { lines } = section(lang, "hero").scene;
---

<div class="voice">
  <div class="prompter">
    <div class="column" data-spoken>
      {
        lines.map((line) => (
          <p>
            {line.split(" ").map((word) => (
              <>
                <span>{word}</span>{" "}
              </>
            ))}
          </p>
        ))
      }
    </div>
  </div>
  <div class="capsule" aria-hidden="true">
    <canvas data-wave="live" data-color="#ffffff" data-level="0.06"></canvas>
    <b data-voice-clock>0:00</b>
    <i></i>
  </div>
</div>

<script>
  import "../scripts/spoken.ts";
</script>

<style>
  .voice {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(12px, 1.6vw, 22px);
    width: 100%;
    height: 100%;
  }

  .prompter {
    flex: 1;
    width: 100%;
    min-height: 0;
    overflow: hidden;
    mask-image: linear-gradient(black 72%, transparent);
  }

  .column {
    transition: transform 0.45s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  .column p {
    max-width: 22em;
    margin: 0 auto 0.55em;
    font-size: clamp(19px, 2.3vw, 31px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-align: center;
    text-wrap: balance;
    color: rgba(0, 0, 0, 0.26);
  }

  .column span {
    margin: 0 -0.1em;
    padding: 0 0.1em;
    border-radius: 4px;
  }

  .column :global(span.said) {
    color: black;
  }

  .column :global(span.now) {
    background: var(--orange-dark);
    color: white;
  }

  .capsule {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 62px;
    padding: 0 9px 0 20px;
    border-radius: 99px;
    background: var(--ink-2);
    color: white;
  }

  canvas {
    width: clamp(150px, 16vw, 220px);
    height: 32px;
  }

  @media (max-width: 680px) {
    .prompter {
      flex: none;
      height: 260px;
    }
  }

  b {
    min-width: 2.6em;
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  i {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 99px;
    background: var(--orange-dark);
  }

  i::after {
    content: "";
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: white;
  }

  @media (prefers-reduced-motion: reduce) {
    .column :global(span) {
      color: black;
    }
  }
</style>
