---
import { supportedLangs } from "../lib/i18n";
import { defaultLang, languages, type Lang } from "../i18n/ui";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const short: Record<Lang, string> = { en: "EN", fr: "FR" };
const groupLabel = lang === "fr" ? "Choix de la langue" : "Language";

function homePath(target: Lang): string {
  return target === defaultLang ? "/" : `/${target}/`;
}
---

<div class="lang-switch" role="group" aria-label={groupLabel}>
  {
    supportedLangs.map((code) =>
      code === lang ? (
        <span class="lang-opt active" aria-current="true">
          {short[code]}
        </span>
      ) : (
        <a
          class="lang-opt"
          href={homePath(code)}
          hreflang={code}
          lang={code}
          aria-label={languages[code]}
        >
          {short[code]}
        </a>
      )
    )
  }
</div>

<style>
  .lang-switch {
    position: fixed;
    top: 18px;
    right: 22px;
    z-index: 95;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--stone-200);
    border-radius: 11px;
    background: color-mix(in srgb, var(--warm-white) 82%, transparent);
    backdrop-filter: blur(16px);
    box-shadow: 0 4px 16px rgba(22, 19, 17, 0.06);
  }
  @media (max-width: 600px) {
    .lang-switch {
      top: 14px;
      right: 14px;
    }
  }
  .lang-opt {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--stone-500);
    text-decoration: none;
    padding: 5px 9px;
    border-radius: 8px;
    transition:
      color 0.15s,
      background 0.15s;
  }
  a.lang-opt:hover {
    color: var(--ink);
  }
  a.lang-opt:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }
  .lang-opt.active {
    color: var(--ink);
    background: var(--warm-white);
    box-shadow: 0 1px 2px rgba(22, 19, 17, 0.08);
  }
</style>
