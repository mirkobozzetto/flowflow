---
interface Props {
  label: string;
}

const { label } = Astro.props;

const TOOLS = [
  { name: "Notion", logo: "notion.svg" },
  { name: "Slack", logo: "slack.svg" },
  { name: "HubSpot", logo: "hubspot.svg" },
  { name: "Outlook", logo: "outlook.svg" },
  { name: "Teams", logo: "teams.svg" },
  { name: "OneDrive", logo: "onedrive.svg" },
  { name: "Zapier", logo: "zapier.svg" },
  { name: "Make", logo: "make.svg" },
  { name: "n8n", logo: "n8n.svg" },
  { name: "Sellsy", logo: "sellsy.png" },
  { name: "Axonaut", logo: "axonaut.png" },
  { name: "Pennylane", logo: "pennylane.png" },
];
---

<div class="mt-7">
  <p class="soon-label">{label}</p>
  <ul class="soon">
    {
      TOOLS.map((tool) => (
        <li>
          <img src={`/logos/${tool.logo}`} alt="" width="16" height="16" />
          {tool.name}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .soon-label {
    margin-bottom: 12px;
    font-size: 17px;
    font-weight: 700;
    color: white;
  }

  .soon {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 36px;
    padding: 0 11px;
    border-radius: 10px;
    background: var(--paper-button);
    box-shadow: var(--paper-edge);
    color: black;
    font-size: 13.5px;
    font-weight: 600;
  }

  img {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }

  @media (max-width: 640px) {
    .soon {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
