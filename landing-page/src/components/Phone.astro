---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["phone", className]}>
  <div class="phone-screen"><slot /></div>
</div>

<style>
  .phone {
    --unit: var(--phone-base, var(--phone-width, 240px));
    position: relative;
    width: var(--phone-width, 240px);
    aspect-ratio: var(--phone-ratio, 720 / 1564);
    flex-shrink: 0;
    padding: calc(var(--unit) * 0.034);
    border-radius: calc(var(--unit) * 0.165);
    background: linear-gradient(
      135deg,
      #9a9a9f 0%,
      #2c2c2f 16%,
      #18181a 50%,
      #2c2c2f 84%,
      #85858a 100%
    );
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.3),
      inset 0 0 0 calc(var(--unit) * 0.014) #0a0a0b,
      0 14px 24px -18px rgba(0, 0, 0, 0.28);
  }

  .phone::before,
  .phone::after {
    content: "";
    position: absolute;
    width: 2px;
    border-radius: 2px;
    background: #4a4a4e;
  }

  .phone::before {
    top: 22%;
    left: -2px;
    height: 13%;
  }

  .phone::after {
    top: 26%;
    right: -2px;
    height: 17%;
  }

  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--unit) * 0.132);
    background: white;
  }

  .phone-screen :global(video),
  .phone-screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
