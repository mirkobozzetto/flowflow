---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["phone", className]}>
  <span class="key action" aria-hidden="true"></span>
  <span class="key vol-up" aria-hidden="true"></span>
  <span class="key vol-down" aria-hidden="true"></span>
  <span class="key side" aria-hidden="true"></span>
  <div class="phone-screen"><slot /></div>
</div>

<style>
  .phone {
    --unit: var(--phone-base, var(--phone-width, 240px));
    position: relative;
    width: var(--phone-width, 240px);
    flex-shrink: 0;
    padding: calc(var(--unit) * 0.034);
    border-radius: calc(var(--unit) * 0.165);
    background: linear-gradient(
      135deg,
      #9a9a9f 0%,
      #2c2c2f 16%,
      #18181a 50%,
      #2c2c2f 84%,
      #85858a 100%
    );
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.3),
      inset 0 0 0 calc(var(--unit) * 0.014) #0a0a0b,
      0 14px 24px -18px rgba(0, 0, 0, 0.28);
  }

  /* Side buttons placed from a current iPhone photo, seen from the front:
     three on the left, one on the right, barely out of the frame. */
  .key {
    --bump: calc(var(--unit) * 0.011);
    position: absolute;
    left: calc(var(--bump) * -1);
    width: var(--bump);
    border-radius: var(--bump) 0 0 var(--bump);
    background: #4a4a4e;
  }

  .action {
    top: 20.5%;
    height: 5%;
  }

  .vol-up {
    top: 28.7%;
    height: 7.9%;
  }

  .vol-down {
    top: 38.3%;
    height: 7.9%;
  }

  .side {
    top: 31.4%;
    right: calc(var(--bump) * -1);
    left: auto;
    height: 12%;
    border-radius: 0 var(--bump) var(--bump) 0;
  }

  .phone-screen {
    position: relative;
    width: 100%;
    /* The screen takes the clip's own shape, so nothing is cropped. */
    aspect-ratio: var(--screen-ratio, 720 / 1564);
    overflow: hidden;
    border-radius: calc(var(--unit) * 0.132);
    background: white;
  }

  .phone-screen :global(video),
  .phone-screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
