---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["phone", className]}>
  <div class="phone-screen"><slot /></div>
</div>

<style>
  .phone {
    --unit: var(--phone-base, var(--phone-width, 240px));
    position: relative;
    width: var(--phone-width, 240px);
    aspect-ratio: 720 / 1564;
    flex-shrink: 0;
    padding: calc(var(--unit) * 0.032);
    border-radius: calc(var(--unit) * 0.16);
    background: linear-gradient(160deg, #3a3531, #161311);
    box-shadow:
      0 50px 90px -34px rgba(22, 19, 17, 0.55),
      0 8px 20px -10px rgba(22, 19, 17, 0.3),
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.16);
  }

  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--unit) * 0.13);
    background: var(--warm-white);
  }

  .phone-screen :global(video),
  .phone-screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
