---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["phone", className]}>
  <div class="phone-screen"><slot /></div>
</div>

<style>
  .phone {
    --unit: var(--phone-base, var(--phone-width, 240px));
    position: relative;
    width: var(--phone-width, 240px);
    aspect-ratio: 720 / 1564;
    flex-shrink: 0;
    padding: calc(var(--unit) * 0.032);
    border-radius: calc(var(--unit) * 0.16);
    background: #000;
  }

  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--unit) * 0.13);
    background: var(--warm-white);
  }

  .phone-screen :global(video),
  .phone-screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
