---
// Draft: the same sentence typed and said, at the speeds measured by Stanford
// (Ruan et al., 2016: 53 vs 161 words per minute on an iPhone, in English).
const SENTENCE = "Rappelle-moi d'envoyer le devis au client avant midi.";
const KEYBOARD_WPM = 53;
const VOICE_WPM = 161;
---

<div
  class="race"
  data-race
  data-sentence={SENTENCE}
  data-keyboard={KEYBOARD_WPM}
  data-voice={VOICE_WPM}
>
  <p class="ratio"><b>3×</b><span>plus rapide<br />que taper</span></p>
  <div class="lanes">
    <div class="lane" data-lane="voice">
      <span class="who">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path
            d="M12 3c-2 0-2 2-2 2v6s0 2 2 2 2-2 2-2V5s0-2-2-2ZM5 10s0 7 7 7 7-7 7-7M12 17v4"
          ></path></svg
        >
        Voix
      </span>
      <span class="text"><span data-text></span><i></i></span>
      <span class="wpm">{VOICE_WPM} mots/min</span>
    </div>
    <div class="lane" data-lane="keyboard">
      <span class="who">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><rect x="3" y="6" width="18" height="12" rx="2"></rect><path
            d="M7 10h.01M11 10h.01M15 10h.01M8 14h8"></path></svg
        >
        Clavier
      </span>
      <span class="text"><span data-text></span><i></i></span>
      <span class="wpm">{KEYBOARD_WPM} mots/min</span>
    </div>
    <p class="src">Mesuré sur iPhone par Stanford, 2016</p>
  </div>
</div>

<script>
  // Words per minute uses 5 characters per word, the text-entry standard.
  const CHARS_PER_WORD = 5;
  const TIME_SCALE = 0.45;
  const HOLD_MS = 1600;

  for (const root of document.querySelectorAll<HTMLElement>("[data-race]")) {
    const sentence = root.dataset.sentence ?? "";
    const lanes = [...root.querySelectorAll<HTMLElement>("[data-lane]")];
    const speed = (lane: HTMLElement): number =>
      Number(root.dataset[lane.dataset.lane ?? ""] ?? 1);
    const msPerChar = (wpm: number): number =>
      (60000 / (wpm * CHARS_PER_WORD)) * TIME_SCALE;

    const run = (): void => {
      const start = performance.now();
      const slowest = Math.min(...lanes.map(speed));
      const total = sentence.length * msPerChar(slowest);
      const frame = (now: number): void => {
        const t = now - start;
        for (const lane of lanes) {
          const shown = Math.min(
            sentence.length,
            Math.floor(t / msPerChar(speed(lane))),
          );
          const text = lane.querySelector<HTMLElement>("[data-text]");
          if (text) text.textContent = sentence.slice(0, shown);
          lane.classList.toggle("done", shown === sentence.length);
        }
        if (t < total + HOLD_MS) requestAnimationFrame(frame);
        else run();
      };
      requestAnimationFrame(frame);
    };
    new IntersectionObserver(
      ([entry], obs) => {
        if (!entry?.isIntersecting) return;
        obs.disconnect();
        run();
      },
      { threshold: 0.4 },
    ).observe(root);
  }
</script>

<style>
  .race {
    display: flex;
    align-items: center;
    gap: 22px;
    width: min(640px, 100%);
    margin-top: 30px;
    padding: 16px 20px 12px;
    border-radius: 20px;
    background: var(--paper);
    box-shadow: var(--paper-lift);
    text-align: left;
  }

  .ratio {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }

  .ratio b {
    background: var(--gradient);
    background-clip: text;
    color: transparent;
    font-size: 54px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .ratio span {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.15;
  }

  .lanes {
    display: grid;
    flex: 1;
    gap: 6px;
    min-width: 0;
  }

  .lane {
    display: grid;
    grid-template-columns: 74px 1fr auto;
    align-items: center;
    gap: 10px;
    height: 30px;
    padding: 0 10px;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.035);
  }

  .lane[data-lane="voice"] {
    background: var(--orange-50);
  }

  .who {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 600;
  }

  .who svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .text {
    overflow: hidden;
    font-size: 12.5px;
    white-space: nowrap;
  }

  .text i {
    display: inline-block;
    width: 1.5px;
    height: 13px;
    margin-left: 1px;
    vertical-align: -2px;
    background: var(--orange-dark);
    animation: caret 1s steps(1) infinite;
  }

  .done .text i {
    display: none;
  }

  .wpm {
    color: rgba(0, 0, 0, 0.5);
    font-size: 11.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .done[data-lane="voice"] .wpm {
    color: var(--orange-dark);
  }

  .src {
    margin: 2px 0 0;
    color: rgba(0, 0, 0, 0.4);
    font-size: 11px;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
</style>
