---
import { Image } from "astro:assets";
import logo from "../../assets/logo.png";

interface Props {
  variant: "note" | "lock";
}

const { variant } = Astro.props;
const LOCK =
  "M7 11V8a5 5 0 0 1 10 0v3M6 11h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1z";
---

<div class:list={["sync", `v-${variant}`]}>
  <div class="dev-phone">
    <span class="island"></span>
    <Image src={logo} alt="" width={22} height={22} />
  </div>
  <div class="line">
    {
      variant === "note" ? (
        <>
          <span class="chip go">Note</span>
          <span class="chip low">chiffré</span>
        </>
      ) : (
        <>
          <span class="lock go">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={LOCK} />
            </svg>
          </span>
          <span class="lock back">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={LOCK} />
            </svg>
          </span>
        </>
      )
    }
  </div>
  <div class="dev-mac">
    <div class="lid"><Image src={logo} alt="" width={26} height={26} /></div>
    <div class="base"></div>
  </div>
</div>

<style>
  .sync {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 26px;
  }

  .sync :global(img) {
    border-radius: 6px;
  }

  .dev-phone {
    position: relative;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 86px;
    border-radius: 11px;
    background: white;
    box-shadow:
      0 0 0 2.5px #1c1c1e,
      0 8px 16px -10px rgba(0, 0, 0, 0.45);
  }

  .island {
    position: absolute;
    top: 6px;
    left: 50%;
    width: 14px;
    height: 4px;
    border-radius: 4px;
    background: #1c1c1e;
    translate: -50% 0;
  }

  .dev-mac {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lid {
    display: grid;
    place-items: center;
    width: 104px;
    height: 66px;
    border: 3px solid #1c1c1e;
    border-bottom-width: 5px;
    border-radius: 8px 8px 3px 3px;
    background: white;
  }

  .base {
    width: 132px;
    height: 7px;
    margin-top: 1px;
    border-radius: 1px 1px 7px 7px;
    background: #1c1c1e;
  }

  .line {
    position: relative;
    flex: 1;
    height: 1.5px;
    background: repeating-linear-gradient(
      90deg,
      var(--orange) 0 6px,
      transparent 6px 12px
    );
    background-size: 12px 100%;
    animation: dash 1.1s linear infinite;
  }

  .chip {
    position: absolute;
    padding: 1px 8px;
    border: 1px solid var(--orange-100);
    border-radius: 99px;
    background: var(--orange-50);
    color: var(--orange-dark);
    font-size: 10px;
  }

  .chip.go {
    top: 50%;
    translate: -50% -50%;
    animation: go 3.4s ease-in-out infinite;
  }

  .chip.low {
    top: 9px;
    left: 50%;
    translate: -50% 0;
  }

  .lock {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--gradient);
    box-shadow: 0 0 0 3px white;
    opacity: 0;
    translate: -50% -50%;
  }

  .lock svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: white;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lock.go {
    animation: go 3.4s ease-in-out infinite;
  }

  .lock.back {
    animation: back 3.4s ease-in-out 1.7s infinite;
  }

  @keyframes go {
    0% {
      left: 0;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    44% {
      left: 100%;
      opacity: 1;
    }
    50%,
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  @keyframes back {
    0% {
      left: 100%;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    44% {
      left: 0;
      opacity: 1;
    }
    50%,
    100% {
      left: 0;
      opacity: 0;
    }
  }
</style>
