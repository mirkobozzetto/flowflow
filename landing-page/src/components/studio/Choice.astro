---
interface Props {
  group: string;
  name: string;
  current?: boolean;
}

const { group, name, current } = Astro.props;
---

<figure class="choice" data-current={current ? "true" : undefined}>
  <div class="choice-stage"><slot /></div>
  <figcaption>
    <span>{current ? "Aujourd'hui" : name}</span>
    <label>
      <input type="checkbox" data-keep={`${group} : ${name}`} />
      Je garde
    </label>
  </figcaption>
</figure>
