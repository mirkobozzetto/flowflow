---
// Draft: the visitor tries it with their own voice, as on superwhisper.com.
// Uses the browser's speech recognition; a scripted sample plays without it.
const SAMPLE = "Envoie le devis au client avant midi";
---

<div class="try" data-try data-sample={SAMPLE}>
  <button type="button" class="mic" data-mic aria-label="Parler">
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path
        d="M12 3c-2 0-2 2-2 2v6s0 2 2 2 2-2 2-2V5s0-2-2-2ZM5 10s0 7 7 7 7-7 7-7M12 17v4M9 21h6"
      ></path></svg
    >
  </button>
  <div class="bubble">
    <p class="hint" data-hint>Appuie, puis dis une demande à ton agent</p>
    <p class="heard" data-heard></p>
    <p class="plan" data-plan>
      <img src="/brand/mascot.webp" alt="" width="18" height="18" />
      <span>Ton agent prépare ça et attend ton <b>go</b></span>
    </p>
  </div>
</div>

<script>
  type Recognition = {
    lang: string;
    interimResults: boolean;
    onresult: ((e: { results: ArrayLike<ArrayLike<{ transcript: string }>> }) => void) | null;
    onend: (() => void) | null;
    onerror: (() => void) | null;
    start: () => void;
  };
  const sleep = (ms: number) => new Promise((done) => setTimeout(done, ms));

  for (const root of document.querySelectorAll<HTMLElement>("[data-try]")) {
    const mic = root.querySelector<HTMLButtonElement>("[data-mic]");
    const heard = root.querySelector<HTMLElement>("[data-heard]");
    const hint = root.querySelector<HTMLElement>("[data-hint]");
    if (!mic || !heard || !hint) continue;

    const finish = (): void => {
      root.dataset.state = heard.textContent ? "planned" : "idle";
    };

    const sample = async (): Promise<void> => {
      root.dataset.state = "listening";
      heard.textContent = "";
      for (const word of (root.dataset.sample ?? "").split(" ")) {
        heard.textContent += `${word} `;
        await sleep(230);
      }
      finish();
    };

    mic.addEventListener("click", () => {
      const Ctor = (window as unknown as Record<string, unknown>)
        .webkitSpeechRecognition as (new () => Recognition) | undefined;
      if (!Ctor) {
        sample();
        return;
      }
      const rec = new Ctor();
      rec.lang = "fr-FR";
      rec.interimResults = true;
      heard.textContent = "";
      root.dataset.state = "listening";
      rec.onresult = (e) => {
        heard.textContent = Array.from(e.results, (r) => r[0]?.transcript ?? "").join(" ");
      };
      rec.onerror = () => {
        hint.textContent = "Dictée bloquée par ce navigateur : voici un exemple";
        sample();
      };
      rec.onend = finish;
      rec.start();
    });
  }
</script>

<style>
  .try {
    display: flex;
    align-items: center;
    gap: 16px;
    width: min(520px, 100%);
    margin-top: 30px;
    text-align: left;
  }

  .mic {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 64px;
    height: 64px;
    border: 0;
    border-radius: 99px;
    background: var(--gradient);
    color: white;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      0 14px 26px -14px var(--orange-dark);
    cursor: pointer;
  }

  .mic::before,
  .mic::after {
    position: absolute;
    inset: 0;
    border-radius: 99px;
    box-shadow: 0 0 0 0 color-mix(in oklch, var(--orange-dark) 40%, transparent);
    animation: ring 2.2s ease-out infinite;
    content: "";
  }

  .mic::after {
    animation-delay: 1.1s;
  }

  [data-state="listening"] .mic::before,
  [data-state="listening"] .mic::after {
    animation-duration: 1s;
  }

  .mic svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bubble {
    position: relative;
    flex: 1;
    min-height: 64px;
    padding: 12px 16px;
    border-radius: 18px;
    background: var(--paper);
    box-shadow: var(--paper-lift);
  }

  .hint {
    margin: 0;
    color: rgba(0, 0, 0, 0.5);
    font-size: 14px;
    font-weight: 600;
  }

  .heard {
    margin: 2px 0 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
  }

  .heard:empty {
    display: none;
  }

  .plan {
    display: none;
    align-items: center;
    gap: 6px;
    margin: 6px 0 0;
    color: var(--orange-dark);
    font-size: 13px;
    font-weight: 600;
  }

  [data-state="planned"] .plan {
    display: flex;
    animation: rise 0.4s ease both;
  }

  [data-state="listening"] .hint,
  [data-state="planned"] .hint {
    display: none;
  }

  @keyframes ring {
    from {
      box-shadow: 0 0 0 0 color-mix(in oklch, var(--orange-dark) 40%, transparent);
    }
    to {
      box-shadow: 0 0 0 18px color-mix(in oklch, var(--orange-dark) 0%, transparent);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
</style>
