---
import Clip from "../Clip.astro";
import Phone from "../Phone.astro";
import { moments } from "../../pages/propositions/_copy";
---

<section class="dayfixed" data-day>
  <div class="dayfixed-stage">
    <Phone><video data-day-video muted loop playsinline poster="/videos/fr/dictate.webp" src="/videos/fr/dictate.mp4"></video></Phone>
  </div>
  <div class="dayfixed-list">
  {
    moments.map((m) => (
      <article class="dayfixed-ch" data-day-clip={m.clip}>
        <div class="dayfixed-hour" aria-hidden="true">{m.hour}</div>
        <div class="dayfixed-said">
          <p>{m.label}</p>
          <h2>« {m.said} »</h2>
        </div>
        <p class="dayfixed-does">{m.does}</p>
        <Phone class="dayfixed-inline"><Clip lang="fr" clip={m.clip} /></Phone>
      </article>
    ))
  }
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>("[data-day-video]");
  const chapters = document.querySelectorAll<HTMLElement>("[data-day-clip]");
  let current = "dictate";

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const clip = (entry.target as HTMLElement).dataset.dayClip;
        if (!entry.isIntersecting || !video || !clip) continue;
        if (clip !== current) {
          current = clip;
          video.poster = `/videos/fr/${clip}.webp`;
          video.src = `/videos/fr/${clip}.mp4`;
        }
        video.play().catch(() => undefined);
      }
    },
    { rootMargin: "-50% 0px -50% 0px" },
  );

  for (const chapter of chapters) observer.observe(chapter);
</script>

<style is:global>
  .dayfixed {
    --phone-width: min(29vh, 21vw);
    position: relative;
    display: grid;
    margin-top: 40px;
  }

  .dayfixed-stage {
    grid-area: 1 / 1;
    position: sticky;
    top: 0;
    z-index: 3;
    align-self: start;
    display: grid;
    place-items: center;
    height: 100svh;
    pointer-events: none;
  }

  .dayfixed-list {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .dayfixed-ch {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(0, calc(min(29vh, 21vw) + 56px)) 1fr;
    align-items: center;
    min-height: 100svh;
    padding: 80px clamp(20px, 4vw, 56px);
    overflow: clip;
  }

  .dayfixed-hour {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--title);
    font-size: 31vw;
    font-weight: 600;
    letter-spacing: -0.05em;
    pointer-events: none;
  }

  .dayfixed-said {
    position: relative;
    grid-column: 1;
  }

  .dayfixed-said p {
    margin-bottom: 12px;
    font-weight: 600;
  }

  .dayfixed-said h2 {
    font-size: clamp(30px, 3.3vw, 52px);
    line-height: 1.06;
    letter-spacing: -0.025em;
  }

  .dayfixed-does {
    position: relative;
    grid-column: 3;
    justify-self: end;
    max-width: 320px;
    font-size: 19px;
  }

  .dayfixed-inline {
    display: none !important;
  }

  @media (max-width: 860px) {
    .dayfixed-stage {
      display: none;
    }

    .dayfixed-ch {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 56px 20px;
    }

    .dayfixed-does {
      grid-column: 1;
      justify-self: start;
      margin-top: 12px;
    }

    .dayfixed-inline {
      --phone-width: 62vw;
      display: block !important;
      justify-self: center;
      margin-top: 28px;
    }
  }
</style>
