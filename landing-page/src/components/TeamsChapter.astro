---
import { Image } from "astro:assets";
import Offer from "./Offer.astro";
import mirko from "../assets/people/mirko.png";
import { section } from "../lib/i18n";
import { appStoreUrl, bookingCode } from "../lib/links";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = section(lang, "teams");
---

<section id="teams" class="container relative isolate pt-35">
  <div class="dot-grid" aria-hidden="true"></div>
  <h2
    class="mx-auto max-w-200 text-center text-[clamp(34px,5.4vw,66px)] leading-[1.02] tracking-[-0.034em]"
  >
    {t.h2Lead}<br /><em class="say">{t.h2Accent}</em>
  </h2>
  <p
    class="mx-auto mt-5 max-w-150 text-center text-[17px]"
  >
    {t.sub}
  </p>

  <div class="mt-14 grid grid-cols-2 gap-7 max-[860px]:grid-cols-1">
    <Offer
      tone="white"
      title={t.solo.title}
      body={t.solo.body}
      points={t.solo.points}
      cta={t.solo.cta}
      href={appStoreUrl(lang)}
      external
    >
      <img
        slot="art"
        class="offer-mascot"
        src="/brand/mascot-sticker.webp"
        alt=""
        width="104"
        height="104"
        loading="lazy"
        decoding="async"
      />
    </Offer>
    <Offer
      tone="orange"
      title={t.guided.title}
      body={t.guided.body}
      points={t.guided.points}
      cta={t.guided.cta}
      href="#book"
      contact={bookingCode()}
    >
      <div slot="art" class="faces">
        <span class="face mirko"><Image src={mirko} alt="" width={96} height={96} /></span>
        <span class="face"><img src="/images/hermes-agent.png" alt="" width="96" height="96" /></span>
      </div>
    </Offer>
  </div>

  <div
    class="unsure mt-12 flex flex-wrap items-center justify-center gap-x-6 gap-y-3"
  >
    <div class="max-w-105 text-right text-balance max-[560px]:text-center">
      <p class="unsure-title text-[20px] font-semibold tracking-[-0.015em] text-ink">
        {t.unsureTitle}
      </p>
      <p class="unsure-text text-[14.5px]">{t.unsureText}</p>
    </div>
    <svg class="arrow-up max-[560px]:hidden" viewBox="0 0 56 72" aria-hidden="true">
      <path d="M6 68C30 66 42 50 44 10"></path>
      <path d="M35 20l9-11 9 11"></path>
    </svg>
    <a
      class="btn-ghost"
      href="#book"
      data-contact={bookingCode()}
      hidden={!bookingCode()}
    >
      {t.guided.cta}
    </a>
  </div>
</section>

<style>
  .dot-grid {
    position: absolute;
    top: 60px;
    right: 0;
    left: 0;
    z-index: -1;
    height: 420px;
    background-image: radial-gradient(
      rgba(0, 0, 0, 0.16) 1px,
      transparent 1.4px
    );
    background-size: 18px 18px;
    mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%);
    pointer-events: none;
  }

  .offer-mascot {
    position: absolute;
    right: 20px;
    bottom: 18px;
    width: 104px;
    height: 104px;
    rotate: 8deg;
  }

  .faces {
    position: absolute;
    top: 28px;
    right: 28px;
    display: flex;
  }

  .face {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    overflow: hidden;
    border-radius: 50%;
    background: white;
    box-shadow: 0 0 0 3px white;
  }

  .face + .face {
    margin-left: -12px;
  }

  .face.mirko {
    background: black;
  }

  .face :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The portrait is cropped tight: shrinking it on black keeps the whole head. */
  .face.mirko :global(img) {
    width: 84%;
    height: 84%;
  }

  @media (max-width: 560px) {
    .faces {
      position: static;
      margin-bottom: 14px;
    }

    .offer-mascot {
      width: 80px;
      height: 80px;
    }
  }

  .arrow-up {
    width: 46px;
    fill: none;
    stroke: black;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
