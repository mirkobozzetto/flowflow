---
import Ticket from "./Ticket.astro";
import { section } from "../lib/i18n";
import { appStoreUrl, bookingUrl, externalLinkAttrs } from "../lib/links";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = section(lang, "teams");
---

<section id="teams" class="container pt-35">
  <div class="fig reveal justify-center">{t.fig}</div>
  <h2
    class="reveal mx-auto mt-4 max-w-200 text-center text-[clamp(34px,5.4vw,66px)] leading-[1.02] tracking-[-0.034em]"
    data-d="1"
  >
    {t.h2Lead}<br /><em class="font-serif font-normal italic text-orange-dark"
      >{t.h2Accent}</em
    >
  </h2>
  <p
    class="reveal mx-auto mt-5 max-w-150 text-center text-[17px] text-stone-500"
    data-d="2"
  >
    {t.sub}
  </p>

  <div class="tickets mt-14 grid grid-cols-2 gap-7 max-[860px]:grid-cols-1">
    <Ticket
      tone="paper"
      title={t.solo.title}
      body={t.solo.body}
      points={t.solo.points}
      stub={t.solo.stub}
      cta={t.solo.cta}
      href={appStoreUrl(lang)}
      external
    />
    <Ticket
      tone="orange"
      title={t.guided.title}
      body={t.guided.body}
      points={t.guided.points}
      stub={t.guided.stub}
      cta={t.guided.cta}
      href={bookingUrl}
      delay="1"
    />
  </div>

  <div
    class="reveal mt-12 flex flex-wrap items-center justify-center gap-x-6 gap-y-3"
  >
    <div class="text-right max-[560px]:text-center">
      <p class="text-[20px] font-semibold tracking-[-0.015em] text-ink">
        {t.unsureTitle}
      </p>
      <p class="text-[14.5px] text-stone-500">{t.unsureText}</p>
    </div>
    <svg class="arrow max-[560px]:hidden" viewBox="0 0 84 38" aria-hidden="true">
      <path d="M3 26C24 6 52 4 76 19"></path>
      <path d="M63 19l14 1-3-14"></path>
    </svg>
    <a class="btn-ghost" href={bookingUrl} {...externalLinkAttrs}>
      {t.guided.cta}
    </a>
  </div>
</section>

<style>
  .arrow {
    width: 74px;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
