---
interface Props {
  width: number;
}

const { width } = Astro.props;
---

<div class="iphone-art" style={`--w: ${width}px`} aria-hidden="true">
  <div class="screen">
    <span class="island"></span>
    <slot />
  </div>
</div>

<style>
  .iphone-art {
    position: relative;
    flex-shrink: 0;
    width: var(--w);
    aspect-ratio: 0.49;
    padding: calc(var(--w) * 0.055);
    border-radius: calc(var(--w) * 0.22);
    background: linear-gradient(
      135deg,
      #9a9a9f 0%,
      #2c2c2f 16%,
      #18181a 50%,
      #2c2c2f 84%,
      #85858a 100%
    );
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.3),
      0 10px 18px -12px rgba(0, 0, 0, 0.45);
  }

  .iphone-art::before,
  .iphone-art::after {
    content: "";
    position: absolute;
    width: 2px;
    border-radius: 2px;
    background: #4a4a4e;
  }

  .iphone-art::before {
    top: 24%;
    left: -2px;
    height: 16%;
  }

  .iphone-art::after {
    top: 28%;
    right: -2px;
    height: 20%;
  }

  .screen {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    border-radius: calc(var(--w) * 0.17);
    background: white;
  }

  .island {
    position: absolute;
    top: calc(var(--w) * 0.07);
    left: 50%;
    width: calc(var(--w) * 0.34);
    height: calc(var(--w) * 0.1);
    border-radius: 99px;
    background: #0a0a0b;
    translate: -50% 0;
  }

  .screen :global(img) {
    width: calc(var(--w) * 0.46);
    height: auto;
    border-radius: calc(var(--w) * 0.1);
  }
</style>
