---
interface Props {
  width: number;
}

const { width } = Astro.props;
---

<div class="iphone-art" style={`--w: ${width}px`} aria-hidden="true">
  <span class="button volume"></span>
  <span class="button power"></span>
  <div class="screen">
    <span class="island"></span>
    <slot />
  </div>
</div>

<style>
  /* Every measure follows the width, so the phone stays crisp from 20px up. */
  .iphone-art {
    position: relative;
    flex-shrink: 0;
    width: var(--w);
    aspect-ratio: 0.486;
    padding: max(1.5px, calc(var(--w) * 0.045));
    border-radius: calc(var(--w) * 0.2);
    background: linear-gradient(150deg, #48484c, #121214 38%, #1c1c1e 70%, #3a3a3e);
    box-shadow:
      inset 0 0 0 max(0.5px, calc(var(--w) * 0.012)) rgba(255, 255, 255, 0.22),
      0 calc(var(--w) * 0.18) calc(var(--w) * 0.3) calc(var(--w) * -0.2)
        rgba(0, 0, 0, 0.5);
  }

  .button {
    position: absolute;
    width: max(1px, calc(var(--w) * 0.03));
    border-radius: 1px;
    background: #2c2c2f;
  }

  .volume {
    top: 24%;
    left: calc(max(1px, calc(var(--w) * 0.03)) * -1);
    height: 13%;
  }

  .power {
    top: 30%;
    right: calc(max(1px, calc(var(--w) * 0.03)) * -1);
    height: 17%;
  }

  .screen {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    border-radius: calc(var(--w) * 0.16);
    background: white;
  }

  .island {
    position: absolute;
    top: calc(var(--w) * 0.065);
    left: 50%;
    width: calc(var(--w) * 0.3);
    height: max(2px, calc(var(--w) * 0.085));
    border-radius: 99px;
    background: #0a0a0b;
    translate: -50% 0;
  }

  .screen :global(img) {
    width: calc(var(--w) * 0.46);
    height: auto;
    border-radius: calc(var(--w) * 0.1);
  }
</style>
