  stroke: true,
};
const FOLDER = {
  box: "0 0 256 256",
  d: "M216,72H130.67L102.93,51.2a16.12,16.12,0,0,0-9.6-3.2H40A16,16,0,0,0,24,64V200a16,16,0,0,0,16,16H216.89A15.13,15.13,0,0,0,232,200.89V88A16,16,0,0,0,216,72Zm0,128H40V64H93.33L123.2,86.4A8,8,0,0,0,128,88h88Z",
  stroke: false,
};
const CHATS = {
  box: "0 0 256 256",
  d: "M232,96a16,16,0,0,0-16-16H184V48a16,16,0,0,0-16-16H40A16,16,0,0,0,24,48V176a8,8,0,0,0,13,6.22L72,154V176a16,16,0,0,0,16,16h93.59L219,222.22A8,8,0,0,0,232,216Zm-16,0V196L202.41,176H88V80H216Z",
  stroke: false,
};
const NOTE = {
  box: "0 0 256 256",
  d: "M229.66,58.34l-32-32a8,8,0,0,0-11.32,0l-96,96A8,8,0,0,0,88,128v32a8,8,0,0,0,8,8h32a8,8,0,0,0,5.66-2.34l96-96A8,8,0,0,0,229.66,58.34ZM124.69,152H104V131.31l64-64L188.69,88ZM200,76.69,179.31,56,192,43.31,212.69,64ZM224,128v80a16,16,0,0,1-16,16H48a16,16,0,0,1-16-16V48A16,16,0,0,1,48,32h80a8,8,0,0,1,0,16H48V208H208V128a8,8,0,0,1,16,0Z",
  stroke: false,
};
const NOTEBOOK = {
  box: "0 0 256 256",
  d: "M208,32H48A16,16,0,0,0,32,48V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V48A16,16,0,0,0,208,32ZM48,48H72V208H48ZM208,208H88V48H208Z",
  stroke: false,
};
const LAYOUTS = {
  left: [
    { icon: MIC, spot: "top: 8%; left: 3%; width: 46px; rotate: -12deg" },
    { icon: FOLDER, spot: "top: 46%; left: 6.5%; width: 34px; rotate: 9deg" },
    { icon: NOTE, spot: "top: 78%; left: 2.5%; width: 40px; rotate: -6deg" },
  ],
  right: [
    { icon: CHATS, spot: "top: 14%; right: 4%; width: 42px; rotate: 10deg" },
    { icon: NOTEBOOK, spot: "top: 52%; right: 2.5%; width: 36px; rotate: -9deg" },
    { icon: MIC, spot: "top: 84%; right: 6%; width: 32px; rotate: 14deg" },
  ],
};
---

{
  LAYOUTS[set].map(({ icon, spot }) => (
    <svg class="ink-icon" viewBox={icon.box} style={spot} aria-hidden="true">
      <path d={icon.d} class:list={{ stroked: icon.stroke }} />
    </svg>
  ))
}

<style>
  .ink-icon {
    position: absolute;
    display: none;
    height: auto;
    fill: rgba(0, 0, 0, 0.07);
    pointer-events: none;
  }

  .stroked {
    fill: none;
    stroke: rgba(0, 0, 0, 0.09);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 1100px) {
    .ink-icon {
      display: block;
    }
  }
</style>
