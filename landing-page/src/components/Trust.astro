---
import { section } from "../lib/i18n";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = section(lang, "trust");
---

<section id="trust" class="container pt-35">
  <h2
    class="text-[clamp(30px,4.4vw,50px)] leading-[1.04] tracking-[-0.027em]"
  >
    {t.h2Lead}<br /><em class="font-serif font-normal italic text-orange-dark"
      >{t.h2Accent}</em
    >
  </h2>

  <div class="split mt-10">
    <div class="stay">
      <h3>{t.stayTitle}</h3>
      <ul>{t.stay.map((item) => <li>{item}</li>)}</ul>
    </div>
    <div class="leave">
      <h3>{t.leaveTitle}</h3>
      <ul>
        {
          t.leave.map((item) => (
            <li>
              <span>{item.what}</span>
              <b class="who">
                {item.logos.map((src) => (
                  <img src={src} alt="" width="18" height="18" />
                ))}
                {item.where}
              </b>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <p class="mt-4 text-[14px]">{t.duty}</p>

  <div class="cost mt-20">
    <div>
      <h3 class="text-[clamp(26px,3vw,34px)] tracking-[-0.022em] text-ink">
        {t.costTitle}
      </h3>
      <p class="mt-3 max-w-85 text-[15px] text-stone-500">{t.costNote}</p>
      <p class="mt-3 text-[12.5px] text-stone-400">{t.costSource}</p>
    </div>
    <dl>
      {
        t.cost.map((row) => (
          <div>
            <dt>{row.what}</dt>
            <dd>{row.price}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    border-radius: 24px;
    box-shadow: 0 0 0 1px var(--rule);
  }

  .stay,
  .leave {
    padding: clamp(26px, 3.4vw, 40px);
  }

  .stay {
    background: white;
    color: black;
  }

  .leave {
    background: var(--gradient);
    color: white;
    font-weight: 600;
  }

  .split h3 {
    font-size: 21px;
    letter-spacing: -0.016em;
    color: var(--ink);
  }

  .leave h3 {
    color: white;
  }

  .split ul {
    display: grid;
    gap: 12px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15.5px;
  }

  .leave li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 14px;
  }

  .who {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 38px;
    padding: 0 13px 0 10px;
    border-radius: 10px;
    background: white;
    color: black;
    font-size: 14.5px;
    font-weight: 600;
  }

  .who img {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    object-fit: contain;
  }

  .cost {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(28px, 6vw, 72px);
    align-items: start;
  }

  dl {
    margin: 0;
    border-top: 1px solid var(--stone-200);
  }

  dl div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 18px;
    padding: 14px 0;
    border-bottom: 1px solid var(--stone-200);
  }

  dt {
    font-size: 15.5px;
    color: var(--stone-600);
  }

  dd {
    margin: 0;
    font-size: 15.5px;
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 760px) {
    .split,
    .cost {
      grid-template-columns: 1fr;
    }

    .leave li {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
