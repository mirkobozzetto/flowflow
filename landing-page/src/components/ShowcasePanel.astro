---
import Clip from "./Clip.astro";
import Phone from "./Phone.astro";

interface Props {
  lang: string;
  time: string;
  title: string;
  text: string;
  clip: string;
}

const { lang, time, title, text, clip } = Astro.props;
---

<article
  class="panel flex w-[min(620px,84vw)] shrink-0 flex-row items-center gap-7 rounded-3xl border border-stone-200 bg-stone-50 p-7.5 max-[560px]:flex-col max-[560px]:items-start"
>
  <div class="flex flex-1 flex-col gap-3">
    <div class="font-serif text-[46px] italic leading-none text-orange tabular-nums">
      {time}
    </div>
    <h3 class="text-[27px] leading-[1.1] tracking-[-0.02em]">{title}</h3>
    <p class="max-w-107.5 text-[15px] text-stone-500">{text}</p>
  </div>
  <Phone class="panel-phone max-[560px]:self-center">
    <Clip lang={lang} clip={clip} />
  </Phone>
</article>

<style>
  .panel {
    --phone-width: clamp(170px, 15vw, 206px);
  }

  @media (max-width: 560px) {
    .panel {
      --phone-width: 230px;
    }
  }
</style>
