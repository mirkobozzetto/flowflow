---
import Clip from "./Clip.astro";
import Phone from "./Phone.astro";

interface Props {
  lang: string;
  num: string;
  step: string;
  title: string;
  text: string;
  facts: string[];
  clip: string;
}

const { lang, num, step, title, text, facts, clip } = Astro.props;
---

<article
  class="panel fine flex w-[min(640px,84vw)] shrink-0 flex-row items-center gap-7 rounded-3xl p-7.5 max-[560px]:flex-col max-[560px]:items-start"
>
  <div class="flex flex-1 flex-col gap-3.5">
    <div class="flex items-baseline gap-3 text-orange-dark">
      <span class="font-serif text-[58px] italic leading-none">{num}</span>
      <span class="step text-[17px] font-semibold">{step}</span>
    </div>
    <h3
      class="text-[clamp(26px,2.6vw,33px)] font-semibold leading-[1.08] tracking-[-0.028em]"
    >
      {title}
    </h3>
    <p class="max-w-107.5 text-[16.5px] leading-[1.45]">{text}</p>
    {
      facts.length > 0 && (
        <ul class="facts">
          {facts.map((fact) => (
            <li>{fact}</li>
          ))}
        </ul>
      )
    }
  </div>
  <Phone class="max-[560px]:self-center">
    <Clip lang={lang} clip={clip} label={title} />
  </Phone>
</article>

<style>
  .panel {
    --phone-width: clamp(150px, 16vw, 196px);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    padding: 6px 11px;
    border-radius: 10px;
    box-shadow: 0 0 0 1px var(--rule);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .panel {
      --phone-width: 62vw;
    }
  }
</style>
