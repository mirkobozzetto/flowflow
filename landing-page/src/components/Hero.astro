---
import CtaButtons from "./CtaButtons.astro";
import ParallaxScene from "./ParallaxScene.astro";
import { useTranslations } from "../lib/i18n";
import { highlight } from "../lib/highlight";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang, "hero");
---

<header class="hero text-center relative">
  <!-- The first screen holds only the pitch: the scene waits below the fold. -->
  <div class="container flex min-h-svh flex-col justify-center pt-29 pb-12">
    <img
      class="hero-logo w-44 h-44 mx-auto block relative"
      src="/brand/mascot.webp"
      alt={t("hero.logoAlt")}
      width="176"
      height="176"
    />
    <h1
      class="mt-6.5 text-[clamp(50px,8.4vw,104px)] leading-[0.99] tracking-[-0.035em] font-semibold text-ink"
    >
      {t("hero.h1Lead")}{" "}
      <em class="voice-word">
        {t("hero.h1Accent")}
        <canvas data-wave="bars" data-speed="2.4" aria-hidden="true"></canvas>
      </em>
    </h1>
    <p
      class="mx-auto mt-1 max-w-160 text-[clamp(22px,2.6vw,28px)] leading-[1.2] font-semibold tracking-[-0.015em] text-balance text-ink"
    >
      {t("hero.lead")}
    </p>
    <p
      class="hero-line mx-auto mt-1.5 max-w-176 text-[15px] text-balance"
    >
      {
        highlight(t("hero.line")).map((part) =>
          part.hl ? <mark class="hl font-semibold">{part.text}</mark> : part.text,
        )
      }
    </p>
    <CtaButtons lang={lang} />
  </div>

  <ParallaxScene lang={lang} />
</header>

<style>
  .hero-logo {
    animation: logoFloat 5.5s ease-in-out infinite;
  }
  @keyframes logoFloat {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-10px) rotate(2deg);
    }
  }
</style>
