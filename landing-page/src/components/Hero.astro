---
import { Image } from "astro:assets";
import CtaButtons from "./CtaButtons.astro";
import ParallaxScene from "./ParallaxScene.astro";
import { useTranslations } from "../lib/i18n";
import logo from "../assets/logo.png";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang, "hero");
---

<header class="hero pt-29 text-center relative">
  <div class="container">
    <Image
      class="hero-logo w-44 h-44 rounded-[44px] mx-auto block relative shadow-[0_14px_24px_-16px_rgba(0,0,0,0.2),inset_0_0_0_1px_rgba(255,255,255,0.4)]"
      src={logo}
      alt={t("hero.logoAlt")}
      width={176}
      height={176}
    />
    <h1
      class="mt-6.5 text-[clamp(50px,8.4vw,104px)] leading-[0.99] tracking-[-0.035em] font-[760] text-ink"
    >
      {t("hero.h1Lead")}{" "}
      <em class="voice-word font-serif italic font-normal text-orange-dark">
        {t("hero.h1Accent")}
        <canvas data-wave="bars" data-voice-wave aria-hidden="true"></canvas>
      </em>
    </h1>
    <p
      class="text-[clamp(15px,1.8vw,17.5px)] text-stone-500 max-w-150 mx-auto mt-4.5"
    >
      {t("hero.subLead")} <b class="text-ink font-semibold">{t("hero.subStrong")}</b>
    </p>
    <CtaButtons
      lang={lang}
      primary={t("hero.ctaPrimary")}
      ghost={t("hero.ctaGhost")}
    />
  </div>

  <ParallaxScene lang={lang} />
</header>

<style>
  .voice-word {
    position: relative;
    display: inline-block;
  }

  .voice-word canvas {
    position: absolute;
    bottom: -0.16em;
    left: -2%;
    width: 104%;
    height: 0.2em;
  }

  .hero-logo {
    animation: logoFloat 5.5s ease-in-out infinite;
  }
  @keyframes logoFloat {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-10px) rotate(2deg);
    }
  }
</style>
