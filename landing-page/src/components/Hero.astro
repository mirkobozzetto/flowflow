---
import CtaButtons from "./CtaButtons.astro";
import HeroSteps from "./HeroSteps.astro";
import ParallaxScene from "./ParallaxScene.astro";
import { useTranslations } from "../lib/i18n";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang, "hero");
---

<header class="hero pt-29 text-center relative">
  <div class="container">
    <img
      class="hero-logo w-44 h-44 mx-auto block relative"
      src="/brand/mascot.webp"
      alt={t("hero.logoAlt")}
      width="176"
      height="176"
    />
    <h1
      class="mt-6.5 text-[clamp(50px,8.4vw,104px)] leading-[0.99] tracking-[-0.035em] font-semibold text-ink"
    >
      {t("hero.h1Lead")}{" "}
      <em class="voice-word">
        {t("hero.h1Accent")}
        <canvas data-wave="bars" data-speed="2.4" aria-hidden="true"></canvas>
      </em>
    </h1>
    <p
      class="text-[clamp(20px,2.2vw,22px)] leading-[1.35] text-ink text-balance max-w-160 mx-auto mt-1"
    >
      {t("hero.subLead")} <b class="font-semibold">{t("hero.subStrong")}</b>
      {t("hero.subTail")}
    </p>
    <HeroSteps steps={t<string[]>("hero.steps")} />
    <CtaButtons lang={lang} />
  </div>

  <ParallaxScene lang={lang} />
</header>

<style>
  .hero-logo {
    animation: logoFloat 5.5s ease-in-out infinite;
  }
  @keyframes logoFloat {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-10px) rotate(2deg);
    }
  }
</style>
