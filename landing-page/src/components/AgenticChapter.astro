---
import ActionCard from "./ActionCard.astro";
import ConnectorChips from "./ConnectorChips.astro";
import SoonConnectors from "./SoonConnectors.astro";
import Clip from "./Clip.astro";
import Phone from "./Phone.astro";
import { section } from "../lib/i18n";
import { hermesUrl } from "../lib/links";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = section(lang, "agentic");
---

<section
  id="agentic"
  class="agentic pt-30 pb-27.5 relative overflow-hidden"
>
  <canvas
    class="bars"
    data-wave="bars"
    data-color="rgba(255,255,255,0.22)"
    data-speed="0.5"
    aria-hidden="true"></canvas>
  <div class="container layout">
    <div>
      <h2
        class="text-[clamp(40px,6.4vw,80px)] leading-[0.99] tracking-[-0.035em]"
      >
        {t.h2Lead}<br /><em class="say say-light">{t.h2Accent}</em>
      </h2>
      <p class="sub mt-5 max-w-150 text-[19px] font-semibold">
        {t.subLead} <b>{t.subStrong}</b>{t.subTail}
      </p>

      <div class="mt-10 grid grid-cols-2 gap-3.5 max-[800px]:grid-cols-1">
        {
          t.actions.map((a) => (
            <ActionCard you={a.you} result={a.then} />
          ))
        }
      </div>

      <ConnectorChips
        label={t.connectorsLabel}
        connectors={t.connectors}
        variant="grid"
      />
      <SoonConnectors label={t.soonLabel} />

      <div class="hermes mt-9">
        <div class="marks" aria-hidden="true">
          <img src="/images/hermes-agent.png" alt="" width="56" height="56" />
          <span>+</span>
          <img
            class="tailscale"
            src="/logos/tailscale.svg"
            alt=""
            width="56"
            height="56"
          />
        </div>
        <p class="note">{t.note}</p>
        <a class="btn-primary" href={hermesUrl}>{t.cta}</a>
      </div>
    </div>

    <div class="device">
      <Phone><Clip lang={lang} clip="agent" label={t.videoLabel} /></Phone>
    </div>
  </div>
</section>

<style>
  .agentic {
    background: var(--gradient);
    color: white;
  }

  .bars {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 110px;
  }

  .sub {
    color: white;
    line-height: 1.35;
  }

  .hermes {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 22px;
    align-items: center;
    padding: 18px 18px 18px 20px;
    border-radius: 22px;
    background: var(--paper);
    box-shadow: var(--paper-lift);
    color: black;
  }

  .marks {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .marks img {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    box-shadow: 0 0 0 1px var(--rule);
  }

  .marks .tailscale {
    padding: 14px;
    background: white;
  }

  .marks span {
    font-size: 20px;
    font-weight: 700;
    color: var(--stone-400);
  }

  .note {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  .hermes .btn-primary {
    min-height: 58px;
    padding: 0 28px;
    font-size: 16.5px;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .hermes {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .hermes .btn-primary {
      justify-content: center;
    }
  }

  .layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }

  .device {
    --phone-width: clamp(240px, 24vw, 300px);
    position: sticky;
    top: 104px;
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .device {
      position: static;
      justify-self: center;
    }
  }
</style>
