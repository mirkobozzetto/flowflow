---
import ActionCard from "./ActionCard.astro";
import ConnectorChips from "./ConnectorChips.astro";
import SoonConnectors from "./SoonConnectors.astro";
import Clip from "./Clip.astro";
import Phone from "./Phone.astro";
import { section } from "../lib/i18n";
import { hermesUrl } from "../lib/links";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = section(lang, "agentic");
---

<section
  id="agentic"
  class="agentic pt-30 pb-27.5 relative overflow-hidden"
>
  <div class="container layout">
    <div>
      <h2
        class="text-[clamp(40px,6.4vw,80px)] leading-[0.99] tracking-[-0.035em]"
      >
        {t.h2Lead}<br /><em
          class="font-serif italic font-normal"
          >{t.h2Accent}</em
        >
      </h2>
      <p class="sub mt-5 max-w-150 text-[19px] font-semibold">
        {t.subLead} <b>{t.subStrong}</b>{t.subTail}
      </p>

      <div class="mt-10 grid grid-cols-2 gap-3.5 max-[800px]:grid-cols-1">
        {
          t.actions.map((a) => (
            <ActionCard you={a.you} result={a.then} />
          ))
        }
      </div>

      <ConnectorChips
        label={t.connectorsLabel}
        connectors={t.connectors}
        variant="grid"
      />
      <SoonConnectors label={t.soonLabel} />

      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
        <a class="btn-white" href={hermesUrl}>{t.cta}</a>
        <p class="note">{t.note}</p>
      </div>
    </div>

    <div class="device">
      <Phone><Clip lang={lang} clip="agent" label={t.videoLabel} /></Phone>
    </div>
  </div>
</section>

<style>
  .agentic {
    background: var(--gradient);
    color: white;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 -1px 0 rgba(0, 0, 0, 0.08);
  }

  .sub {
    color: white;
    line-height: 1.35;
  }

  .note {
    max-width: 420px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: white;
  }

  .layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }

  .device {
    --phone-width: clamp(240px, 24vw, 300px);
    position: sticky;
    top: 104px;
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .device {
      position: static;
      justify-self: center;
    }
  }
</style>
