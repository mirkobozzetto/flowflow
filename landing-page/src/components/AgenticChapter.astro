---
import ActionCard from "./ActionCard.astro";
import ConnectorChips from "./ConnectorChips.astro";
import EmailCapture from "./EmailCapture.astro";
import { section } from "../lib/i18n";

interface Props {
  lang: string;
  captureEndpoint?: string;
}

const { lang, captureEndpoint = "" } = Astro.props;
const t = section(lang, "agentic");
const delays: Array<0 | 1 | 2 | 3> = [0, 1, 1, 2];
---

<section id="agentic" class="agentic">
  <div class="container">
    <div class="fig reveal">{t.fig}</div>
    <h2 class="reveal" data-d="1">
      {t.h2Lead}<br /><em>{t.h2Accent}</em>
    </h2>
    <p class="sub reveal" data-d="2">
      {t.subLead} <b>{t.subStrong}</b>{t.subTail}
    </p>

    <div class="actions">
      {
        t.actions.map((a, i) => (
          <ActionCard
            you={a.you}
            then={a.then}
            soon={a.soon}
            soonLabel={t.soonBadge}
            delay={delays[i] ?? 0}
          />
        ))
      }
    </div>

    <ConnectorChips label={t.connectorsLabel} connectors={t.connectors} />

    <EmailCapture
      title={t.capture.title}
      blurb={t.capture.blurb}
      placeholder={t.capture.placeholder}
      inputLabel={t.capture.inputLabel}
      submit={t.capture.submit}
      ok={t.capture.ok}
      endpoint={captureEndpoint}
    />
  </div>
</section>

<style>
  .agentic {
    margin-top: 150px;
    background: var(--ink);
    color: var(--stone-200);
    padding: 120px 0 110px;
    position: relative;
    overflow: hidden;
  }
  .agentic::before {
    content: "";
    position: absolute;
    inset: -10%;
    background: radial-gradient(
      40% 50% at 75% 10%,
      color-mix(in srgb, var(--orange) 17%, transparent),
      transparent 70%
    );
  }
  .agentic :global(.fig) {
    color: var(--stone-500);
  }
  .agentic :global(.fig::before) {
    background: var(--stone-700);
  }
  .agentic h2 {
    font-size: clamp(40px, 6.4vw, 80px);
    line-height: 0.99;
    letter-spacing: -0.035em;
    color: var(--warm-white);
    margin-top: 20px;
  }
  .agentic h2 em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    color: var(--orange-bright);
  }
  .agentic .sub {
    color: var(--stone-400);
    font-size: 17px;
    max-width: 600px;
    margin-top: 20px;
  }
  .agentic .sub :global(b) {
    color: var(--stone-200);
  }
  .actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 54px;
    position: relative;
  }
  @media (max-width: 800px) {
    .actions {
      grid-template-columns: 1fr;
    }
  }
</style>
