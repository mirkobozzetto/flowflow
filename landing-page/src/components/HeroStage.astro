---
import Phone from "./Phone.astro";
import StageVideo from "./StageVideo.astro";
import { section } from "../lib/i18n";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { stage } = section(lang, "hero");
const firstClip = stage.choices[0]?.clip;
---

<div class="container stage" data-stage data-lang={lang}>
  <div class="picker reveal" data-d="1">
    <p class="question">
      {stage.question}
      <svg class="arrow" viewBox="0 0 84 38" aria-hidden="true">
        <path d="M3 8c16 21 42 26 74 16"></path>
        <path d="M66 15l12 8-11 11"></path>
      </svg>
    </p>
    <div class="choices" role="group" aria-label={stage.group}>
      {
        stage.choices.map((choice) => (
          <button
            class="choice"
            type="button"
            data-clip={choice.clip}
            aria-pressed={choice.clip === firstClip ? "true" : "false"}
          >
            {choice.label}
          </button>
        ))
      }
    </div>
  </div>

  <div class="device reveal" data-d="2" data-device data-format="story">
    <Phone><StageVideo lang={lang} /></Phone>
    <span class="chip chip-wave" aria-hidden="true">
      <i></i><i></i><i></i><i></i><i></i><i></i><i></i><b>0:14</b>
    </span>
    <span class="chip chip-tag" aria-hidden="true">{stage.chips.tag}</span>
    <span class="chip chip-source" aria-hidden="true"
      >{stage.chips.source}</span
    >
    <span class="chip chip-reminder" aria-hidden="true"
      >{stage.chips.reminder}</span
    >
  </div>

  <div class="captions reveal" data-d="3" aria-live="polite">
    {
      stage.choices.map((choice) => (
        <div data-caption={choice.clip} hidden={choice.clip !== firstClip}>
          <h2>{choice.title}</h2>
          <p>{choice.text}</p>
        </div>
      ))
    }
  </div>
</div>

<style>
  .stage {
    --phone-base: clamp(226px, 19.5vw, 268px);
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
    margin-top: 44px;
    text-align: left;
  }

  .picker {
    justify-self: end;
    max-width: 240px;
  }

  .question {
    position: relative;
    font-family: var(--serif);
    font-style: italic;
    font-size: 24px;
    line-height: 1.15;
    color: var(--stone-600);
  }

  .arrow {
    display: block;
    width: 72px;
    margin: 6px 0 10px auto;
    fill: none;
    stroke: var(--orange);
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .choices {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  .choice {
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--stone-200);
    border-radius: 13px;
    background: var(--warm-white);
    color: var(--stone-600);
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 500;
    cursor: pointer;
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease,
      transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .choice:hover {
    border-color: var(--stone-300);
    color: var(--ink);
    transform: translateX(-3px);
  }

  .choice[aria-pressed="true"] {
    border-color: var(--ink);
    background: var(--ink);
    color: white;
  }

  .device {
    --phone-width: var(--phone-base);
    position: relative;
  }

  .device[data-format="story"] {
    --phone-width: calc(var(--phone-base) * 1.2219);
  }

  .device :global(.phone) {
    height: calc(var(--phone-base) * 2.1722);
    aspect-ratio: auto;
    transition: width 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .chip {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    min-height: 36px;
    padding: 0 13px;
    border: 1px solid var(--stone-200);
    border-radius: 12px;
    background: white;
    color: var(--ink);
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 14px 28px -16px rgba(22, 19, 17, 0.4);
    animation: chipFloat 6s ease-in-out infinite;
  }

  .chip-wave {
    top: 10%;
    left: -58px;
    min-height: 40px;
    border: none;
    border-radius: 99px;
    background: var(--ink);
    color: white;
    rotate: -4deg;
  }

  .chip-wave i {
    width: 3px;
    height: 16px;
    border-radius: 99px;
    background: var(--orange-bright);
    animation: wave 1.1s ease-in-out infinite;
  }

  .chip-wave i:nth-child(2) {
    animation-delay: -0.2s;
  }

  .chip-wave i:nth-child(3) {
    animation-delay: -0.45s;
  }

  .chip-wave i:nth-child(4) {
    animation-delay: -0.7s;
  }

  .chip-wave i:nth-child(5) {
    animation-delay: -0.3s;
  }

  .chip-wave i:nth-child(6) {
    animation-delay: -0.85s;
  }

  .chip-wave i:nth-child(7) {
    animation-delay: -0.55s;
  }

  .chip-wave b {
    margin-left: 6px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .chip-tag {
    top: 32%;
    right: -66px;
    rotate: 3deg;
    color: var(--orange-dark);
    animation-delay: -2s;
  }

  .chip-source {
    bottom: 30%;
    left: -44px;
    rotate: 2deg;
    animation-delay: -3.4s;
  }

  .chip-reminder {
    bottom: 13%;
    right: -52px;
    rotate: -3deg;
    animation-delay: -1.2s;
  }

  .captions {
    max-width: 280px;
  }

  .captions h2 {
    font-size: clamp(25px, 2.5vw, 32px);
    line-height: 1.08;
    letter-spacing: -0.024em;
    color: var(--ink);
  }

  .captions p {
    margin-top: 10px;
    font-size: 15.5px;
    color: var(--stone-500);
  }

  .captions [hidden] {
    display: none;
  }

  @keyframes chipFloat {
    50% {
      transform: translateY(-7px);
    }
  }

  @keyframes wave {
    50% {
      transform: scaleY(0.35);
    }
  }

  @media (max-width: 1020px) {
    .stage {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 26px;
    }

    .device {
      order: -1;
    }

    .chip {
      display: none;
    }

    .picker {
      justify-self: center;
      max-width: none;
    }

    .question {
      display: none;
    }

    .choices {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }

    .captions {
      max-width: 420px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip,
    .chip-wave i {
      animation: none;
    }

    .device :global(.phone) {
      transition: none;
    }
  }
</style>
