---
interface Props {
  text: string;
  label?: string;
  code?: boolean;
  copy?: { id: string; button: string; done: string };
}

const { text, label, code = false, copy } = Astro.props;
const Tag = code ? "pre" : "p";
---

<div class="block">
  {
    label && (
      <div class="head">
        <span>{label}</span>
        {copy && (
          <button
            class="copy"
            type="button"
            data-copy={copy.id}
            data-done={copy.done}
          >
            {copy.button}
          </button>
        )}
      </div>
    )
  }
  <Tag class:list={["body", { mono: code }]} id={copy?.id}>{text}</Tag>
</div>

<style>
  .block {
    margin-top: 14px;
    overflow: hidden;
    border-radius: 16px;
    background: var(--ink-2);
    color: white;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px 10px 16px;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.12);
    font-size: 13px;
    font-weight: 600;
  }

  .copy {
    padding: 5px 12px;
    border: none;
    border-radius: 9px;
    background: white;
    color: black;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .body {
    margin: 0;
    padding: 14px 16px;
    font-size: 15px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .mono {
    overflow-x: auto;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 13px;
    white-space: pre;
  }
</style>
