---
import { getStarCount } from "../lib/github";

interface Props {
  label: string;
}

const { label } = Astro.props;
const stars = await getStarCount();

const starPath =
  "M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 " +
  "9.1l6.9-.8z";
---

<span class="gh-stars" aria-label={label}>
  <svg
    width="12"
    height="12"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d={starPath}></path>
  </svg>
  <b>{stars}</b>
</span>

<style>
  .gh-stars {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border-left: 1px solid var(--stone-200);
    padding-left: 10px;
    margin-left: 2px;
    color: var(--stone-500);
    font-size: 12.5px;
  }
  .gh-stars svg {
    color: var(--orange);
  }
  .gh-stars b {
    font-weight: 600;
    color: var(--stone-700);
  }
</style>
