---
import { APPLE_PATH } from "../lib/icons";
import { appStoreUrl, externalLinkAttrs, macDownloadUrl } from "../lib/links";

interface Props {
  lang: string;
  primary: string;
  ghost: string;
}

const { lang, primary, ghost } = Astro.props;
---

<div class="hero-ctas">
  <a class="btn-primary" href={appStoreUrl(lang)} {...externalLinkAttrs}>
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={APPLE_PATH}></path>
    </svg>
    {primary}
  </a>
  <a class="btn-ghost" href={macDownloadUrl} {...externalLinkAttrs}>
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5M5 20h14"></path>
    </svg>
    {ghost}
  </a>
</div>
