---
import { Image } from "astro:assets";
import { useTranslations, localizePath } from "../lib/i18n";
import { APPLE_PATH } from "../lib/icons";
import { appStoreUrl, externalLinkAttrs, hermesUrl } from "../lib/links";
import LangSwitcher from "./LangSwitcher.astro";
import logo from "../assets/logo.png";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang, "hero");
const home = localizePath("/", lang);
const hermes = localizePath(hermesUrl, lang);
const onHermes = Astro.url.pathname.startsWith(hermes);
const hermesAttrs = onHermes ? { "aria-current": "page" as const } : {};
const sections = ["product", "agentic", "teams", "faq"] as const;
---

<nav class="fixed top-0 left-0 right-0 z-90 px-3">
  <div
    class="nav-inner relative flex items-center justify-between max-w-295 mx-auto mt-3.5 py-1.75 pr-2 pl-4 max-lg:pr-1 border border-[rgba(0,0,0,0.09)] rounded-2xl"
  >
    <a
      class="brand flex items-center gap-2.5 font-bold text-[15px] text-ink no-underline"
      href={localizePath("/", lang)}
    >
      <Image src={logo} alt="" width={26} height={26} />
      FlowFlow
    </a>

    <div class="flex items-center gap-2">
      <div class="hidden lg:flex items-center gap-1">
        {
          sections.map((id) => (
            <a class="nav-link" href={`${home}#${id}`}>
              {t(`nav.${id}`)}
            </a>
          ))
        }
        <a class="nav-link" href={hermes} {...hermesAttrs}>{t("nav.hermes")}</a>
      </div>

      <a
        class="nav-cta hidden lg:inline-flex"
        href={appStoreUrl(lang)}
        {...externalLinkAttrs}
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={APPLE_PATH}></path>
        </svg>
        {t("nav.cta")}
      </a>

      <LangSwitcher lang={lang} />

      <button
        class="mobile-toggle flex lg:hidden w-10 h-10 items-center justify-center border-none rounded-[10px] bg-transparent text-stone-600 cursor-pointer"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </div>

    <div
      class="mobile-panel lg:hidden absolute left-0 right-0 flex flex-col gap-1 p-3 border border-[rgba(0,0,0,0.09)] rounded-2xl"
      id="mobile-menu"
      data-open="false"
    >
      {
        sections.map((id) => (
          <a class="nav-link" href={`${home}#${id}`}>
            {t(`nav.${id}`)}
          </a>
        ))
      }
      <a class="nav-link" href={hermes} {...hermesAttrs}>{t("nav.hermes")}</a>
      <span class="h-px bg-stone-200 my-1" aria-hidden="true"></span>
      <a class="nav-cta flex" href={appStoreUrl(lang)} {...externalLinkAttrs}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={APPLE_PATH}></path>
        </svg>
        {t("nav.cta")}
      </a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const panel = document.getElementById("mobile-menu");
  if (toggle && panel) {
    const close = () => {
      panel.setAttribute("data-open", "false");
      toggle.setAttribute("aria-expanded", "false");
    };
    toggle.addEventListener("click", () => {
      const open = panel.getAttribute("data-open") === "true";
      const next = open ? "false" : "true";
      panel.setAttribute("data-open", next);
      toggle.setAttribute("aria-expanded", next);
    });
    for (const link of panel.querySelectorAll("a")) {
      link.addEventListener("click", close);
    }
  }
</script>

<style>
  .nav-inner {
    background: color-mix(in srgb, var(--warm-white) 93%, transparent);
    backdrop-filter: blur(20px) saturate(1.2);
  }
  .brand img {
    width: 26px;
    height: 26px;
    border-radius: 7px;
  }
  .nav-link {
    font-size: 13.5px;
    font-weight: 500;
    color: black;
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 9px;
    transition: 0.15s;
  }
  .nav-link[aria-current="page"] {
    color: black;
    font-weight: 600;
    background: linear-gradient(
        180deg,
        transparent 56%,
        var(--orange-100) 56%,
        var(--orange-100) 90%,
        transparent 90%
      )
      content-box;
  }
  .nav-link[aria-current="page"]:hover {
    background: linear-gradient(
        180deg,
        transparent 30%,
        var(--orange-100) 30%,
        var(--orange-100) 92%,
        transparent 92%
      )
      content-box;
  }
  .nav-link:not([aria-current="page"]):hover {
    color: var(--ink);
    background: var(--stone-100);
  }
  .nav-cta {
    font-size: 13.5px;
    font-weight: 600;
    color: white;
    background: var(--gradient);
    padding: 9px 18px;
    border-radius: 10px;
    text-decoration: none;
    text-align: center;
    align-items: center;
    justify-content: center;
    gap: 7px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.34),
      0 0 0 1px color-mix(in srgb, var(--orange) 82%, black);
    transition: filter 0.2s ease;
  }
  .nav-cta svg {
    width: 15px;
    height: 15px;
  }
  .nav-cta:hover {
    filter: brightness(1.05);
  }
  @media (max-width: 1023px) {
    /* On a phone the page must not show through or above the menu. */
    nav::before {
      content: "";
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      z-index: -1;
      height: calc(100% + 12px);
      background: linear-gradient(var(--warm-white) 62%, transparent);
      pointer-events: none;
    }
    .nav-inner {
      background: var(--warm-white);
      backdrop-filter: none;
    }
  }
  .mobile-panel {
    top: calc(100% + 8px);
    background: color-mix(in srgb, var(--warm-white) 97%, transparent);
    backdrop-filter: blur(20px);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .mobile-panel[data-open="true"] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
</style>
