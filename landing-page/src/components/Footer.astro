---
import { section } from "../lib/i18n";
import GithubStars from "./GithubStars.astro";
import { repoUrl, licenseUrl, externalLinkAttrs } from "../lib/links";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = section(lang, "footer");

const githubPath =
  "M12 .5C5.6.5.5 5.6.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2" +
  ".7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1." +
  "2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5." +
  "7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1" +
  " 5.8 0C17 4.7 18 5 18 5c.6 1.6.2 2.8.1 3.1.7.8 1.2 1.8 1.2 3.1 0 4.4-" +
  "2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .4.2.7.8.6 4.6-1.5 7.9-5.8 7.9-" +
  "10.9C23.5 5.6 18.4.5 12 .5z";
---

<footer class="border-t border-stone-200 pt-7.5 pb-11.5">
  <div
    class="container flex flex-wrap items-center gap-5 text-[13px] text-stone-400"
  >
    <span>{t.footer.copyright}</span>
    <a
      href={licenseUrl}
      {...externalLinkAttrs}
      class="text-stone-500 no-underline transition-colors hover:text-ink"
      >{t.footer.license}</a
    >
    <a
      class="inline-flex items-center gap-2.25 rounded-[11px] border border-stone-200 bg-warm-white px-3.5 py-2 text-[13.5px] font-semibold text-ink! transition-[border-color,box-shadow] duration-200 hover:border-stone-300 hover:shadow-[0_6px_18px_-12px_rgba(22,19,17,0.25)]"
      href={repoUrl}
      {...externalLinkAttrs}
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d={githubPath}></path>
      </svg>
      {t.footer.github}
      <GithubStars label={t.footer.starsAlt} />
    </a>
    <span class="ml-auto"></span>
    <span>{t.footer.madeWith}</span>
  </div>
</footer>
