---
import { section } from "../lib/i18n";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = section(lang, "bento");
---

<section class="block container">
  <div class="fig reveal">{t.fig}</div>
  <h2 class="reveal" data-d="1">{t.h2Lead}<br />{t.h2Accent}</h2>
  <div class="bento">
    <div class="tile t-a reveal">
      <h3>{t.chat.title}</h3>
      <p>{t.chat.body}</p>
      <div class="media-fill">
        <div class="slot">{t.chat.macSlot}</div>
      </div>
      <div class="iphone-mini tile-phone">
        <div class="screen">
          <div class="slot slot-xs">
            {t.chat.phoneSlot}<small>{t.chat.phoneSlotNote}</small>
          </div>
        </div>
      </div>
    </div>

    <div class="tile t-b reveal" data-d="1">
      <h3>{t.sync.title}</h3>
      <p>{t.sync.body}</p>
      <div class="sync-visual">
        <div class="device"></div>
        <div class="sync-line"><span class="lock">{t.sync.lock}</span></div>
        <div class="device macd"></div>
      </div>
    </div>

    <div class="tile t-c reveal">
      <h3>{t.offline.title}</h3>
      <p>{t.offline.body}</p>
    </div>

    <div class="tile t-d reveal" data-d="1">
      <h3>{t.keyboard.title}</h3>
      <p>{t.keyboard.body}</p>
      <div class="kbds">
        <kbd>⌘N</kbd>
        <kbd>⇧⌘Enter</kbd>
        <kbd>⌘F</kbd>
        <kbd>⌃⌃</kbd>
        <kbd>⌘←</kbd>
        <kbd>⌘→</kbd>
      </div>
    </div>
  </div>
</section>

<style>
  section.block {
    padding: 140px 0 0;
  }
  .block h2 {
    font-size: clamp(30px, 4.4vw, 50px);
    letter-spacing: -0.027em;
    margin-top: 16px;
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: 96px;
    gap: 14px;
    margin-top: 44px;
  }
  .tile {
    background: var(--stone-50);
    border: 1px solid var(--stone-200);
    border-radius: 20px;
    padding: 24px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .tile:hover {
    border-color: var(--orange-100);
    box-shadow: 0 10px 30px -22px rgba(22, 19, 17, 0.25);
  }
  .tile h3 {
    font-size: 17px;
    margin-bottom: 5px;
    letter-spacing: -0.01em;
  }
  .tile p {
    font-size: 13px;
    color: var(--stone-500);
    max-width: 320px;
  }
  .t-a {
    grid-column: span 4;
    grid-row: span 3;
  }
  .t-b {
    grid-column: span 2;
    grid-row: span 3;
  }
  .t-c {
    grid-column: span 3;
    grid-row: span 2;
  }
  .t-d {
    grid-column: span 3;
    grid-row: span 2;
  }
  @media (max-width: 880px) {
    .t-a,
    .t-b,
    .t-c,
    .t-d {
      grid-column: span 6;
      grid-row: span 3;
    }
  }
  .slot {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    color: var(--stone-400);
    font-size: 13px;
    font-weight: 500;
    text-align: center;
    padding: 18px;
    background:
      radial-gradient(
        85% 120% at 50% 0%,
        var(--orange-50) 0%,
        transparent 60%
      ),
      var(--stone-50);
    border: 2px dashed var(--stone-300);
    border-radius: inherit;
  }
  .slot small {
    font-size: 11px;
    opacity: 0.85;
  }
  .slot-xs {
    font-size: 10px;
  }
  .tile .media-fill {
    position: absolute;
    inset: auto 0 0 0;
    top: 96px;
    border-top: 1px solid var(--stone-200);
  }
  .tile .media-fill .slot {
    border: none;
    border-radius: 0;
  }
  .iphone-mini {
    width: clamp(150px, 16vw, 196px);
    aspect-ratio: 9/19.5;
    border-radius: 30px;
    padding: 7px;
    position: relative;
    flex-shrink: 0;
    background: linear-gradient(160deg, #3a3531, #161311);
    box-shadow:
      0 26px 50px -22px rgba(22, 19, 17, 0.45),
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.14);
  }
  .iphone-mini::before {
    content: "";
    position: absolute;
    top: 15px;
    left: 50%;
    transform: translateX(-50%);
    width: 32%;
    height: 17px;
    background: #0b0908;
    border-radius: 99px;
    z-index: 2;
  }
  .iphone-mini .screen {
    width: 100%;
    height: 100%;
    border-radius: 23px;
    overflow: hidden;
    background: var(--warm-white);
  }
  .tile-phone {
    position: absolute;
    right: 22px;
    bottom: 18px;
    width: 124px;
    border-radius: 22px;
    padding: 5px;
    z-index: 2;
  }
  .tile-phone::before {
    top: 10px;
    height: 12px;
  }
  .tile-phone .screen {
    border-radius: 17px;
  }
  .kbds {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 14px;
  }
  kbd {
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    color: var(--stone-600);
    background: var(--warm-white);
    border: 1px solid var(--stone-200);
    border-bottom-width: 2px;
    border-radius: 7px;
    padding: 3px 9px;
  }
  .sync-visual {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 22px;
  }
  .device {
    width: 42px;
    height: 62px;
    border: 1.5px solid var(--stone-300);
    border-radius: 9px;
    background: var(--warm-white);
  }
  .device.macd {
    width: 84px;
    height: 54px;
    border-radius: 7px;
  }
  .sync-line {
    flex: 1;
    height: 1.5px;
    background: repeating-linear-gradient(
      90deg,
      var(--orange) 0 6px,
      transparent 6px 12px
    );
    background-size: 12px 100%;
    animation: dash 1.1s linear infinite;
    position: relative;
  }
  @keyframes dash {
    to {
      background-position: 12px 0;
    }
  }
  .lock {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--orange-50);
    border: 1px solid var(--orange-100);
    color: var(--orange-dark);
    font-size: 10px;
    border-radius: 99px;
    padding: 1px 8px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sync-line {
      animation: none;
    }
  }
</style>
