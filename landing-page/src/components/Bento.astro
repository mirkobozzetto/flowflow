---
import { Image } from "astro:assets";
import Clip from "./Clip.astro";
import Phone from "./Phone.astro";
import { section } from "../lib/i18n";
import logo from "../assets/logo.png";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = section(lang, "bento");
---

<section class="container pt-35">
  <h2
    class="text-[clamp(30px,4.4vw,50px)] leading-[1.04] tracking-[-0.027em]"
  >
    {t.h2Lead}<br />{t.h2Accent}
  </h2>
  <div
    class="mt-11 grid grid-cols-6 gap-3.5 auto-rows-[96px] max-md:*:col-span-6 max-md:*:row-span-3 max-md:first:*:row-span-5"
  >
    <div
      class="fine relative overflow-hidden rounded-[20px] p-6 col-span-4 row-span-3"
    >
      <h3 class="mb-1.25 text-[17px] tracking-[-0.01em]">{t.chat.title}</h3>
      <p class="max-w-72 text-[13.5px]">{t.chat.body}</p>
      <div class="shots">
        <Phone class="back">
          <img
            src={`/shots/${lang}/09.webp`}
            alt={t.chat.shot2Alt}
            width="900"
            height="1955"
            loading="lazy"
            decoding="async"
          />
        </Phone>
        <Phone class="front">
          <Clip lang={lang} clip="answer" label={t.chat.shotAlt} />
        </Phone>
      </div>
    </div>

    <div
      class="fine relative overflow-hidden rounded-[20px] p-6 col-span-2 row-span-3"
    >
      <h3 class="mb-1.25 text-[17px] tracking-[-0.01em]">{t.sync.title}</h3>
      <p class="max-w-80 text-[13.5px]">{t.sync.body}</p>
      <div class="sync-visual mt-5.5 flex items-center gap-3">
        <div class="device">
          <Image src={logo} alt="" width={22} height={22} />
        </div>
        <div class="sync-line"><span class="lock">{t.sync.lock}</span></div>
        <div class="device macd">
          <Image src={logo} alt="" width={26} height={26} />
        </div>
      </div>
    </div>

    <div
      class="fine relative overflow-hidden rounded-[20px] p-6 col-span-3 row-span-2"
    >
      <h3 class="mb-1.25 text-[17px] tracking-[-0.01em]">{t.offline.title}</h3>
      <p class="max-w-80 text-[13.5px]">{t.offline.body}</p>
    </div>

    <div
      class="fine relative overflow-hidden rounded-[20px] p-6 col-span-3 row-span-2"
    >
      <h3 class="mb-1.25 text-[17px] tracking-[-0.01em]">{t.keyboard.title}</h3>
      <p class="max-w-80 text-[13.5px]">{t.keyboard.body}</p>
      <div class="mt-3.5 flex flex-wrap gap-1.75">
        <kbd>⌘N</kbd>
        <kbd>⇧⌘Enter</kbd>
        <kbd>⌘F</kbd>
        <kbd>⌃⌃</kbd>
        <kbd>⌘←</kbd>
        <kbd>⌘→</kbd>
      </div>
    </div>
  </div>
</section>

<style>
  .shots {
    --phone-width: 196px;
    position: absolute;
    top: 30px;
    right: 28px;
    display: flex;
    align-items: flex-start;
  }

  .shots :global(.back) {
    margin-top: 44px;
    margin-right: -36px;
    rotate: -4deg;
  }

  .shots :global(.front) {
    rotate: 2deg;
  }

  @media (max-width: 768px) {
    .shots {
      top: 158px;
      right: 50%;
      transform: translateX(50%);
    }

    .shots :global(.back) {
      display: none;
    }

    .shots :global(.front) {
      rotate: 0deg;
    }
  }

  kbd {
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    color: var(--stone-600);
    background: var(--warm-white);
    border: 1px solid var(--stone-200);
    border-bottom-width: 2px;
    border-radius: 7px;
    padding: 3px 9px;
  }
  .device {
    width: 42px;
    height: 62px;
    border-radius: 9px;
    background: var(--paper-button);
    box-shadow: var(--paper-edge);
    display: grid;
    place-items: center;
  }

  .device :global(img) {
    border-radius: 6px;
  }
  .device.macd {
    width: 84px;
    height: 54px;
    border-radius: 7px;
  }
  .sync-line {
    flex: 1;
    height: 1.5px;
    background: repeating-linear-gradient(
      90deg,
      var(--orange) 0 6px,
      transparent 6px 12px
    );
    background-size: 12px 100%;
    animation: dash 1.1s linear infinite;
    position: relative;
  }
  @keyframes dash {
    to {
      background-position: 12px 0;
    }
  }
  .lock {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--orange-50);
    border: 1px solid var(--orange-100);
    color: var(--orange-dark);
    font-size: 10px;
    border-radius: 99px;
    padding: 1px 8px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sync-line {
      animation: none;
    }
  }
</style>
