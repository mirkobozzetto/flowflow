---
import Clip from "./Clip.astro";
import Phone from "./Phone.astro";
import AirplaneTyping from "./bento/AirplaneTyping.astro";
import ShortcutWindow from "./bento/ShortcutWindow.astro";
import SyncDevices from "./bento/SyncDevices.astro";
import { section } from "../lib/i18n";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = section(lang, "bento");
---

<section class="edge relative overflow-x-clip pt-35">
 <div class="container">
  <h2
    class="text-[clamp(30px,4.4vw,50px)] leading-[1.04] tracking-[-0.027em]"
  >
    {t.h2Lead}<br />{t.h2Accent}
  </h2>
  <div
    class="mt-11 grid grid-cols-6 gap-3.5 auto-rows-[96px] max-md:*:col-span-6 max-md:*:row-span-3 max-md:first:*:row-span-5"
  >
    <div
      class="fine relative overflow-hidden rounded-[20px] p-6 col-span-4 row-span-3"
    >
      <h3 class="mb-1.25 text-[17px] tracking-[-0.01em]">{t.chat.title}</h3>
      <p class="max-w-72 text-[13.5px]">{t.chat.body}</p>
      <div class="shots">
        <Phone class="back">
          <img
            src={`/shots/${lang}/09.webp`}
            alt={t.chat.shot2Alt}
            width="900"
            height="1955"
            loading="lazy"
            decoding="async"
          />
        </Phone>
        <Phone class="front">
          <Clip lang={lang} clip="answer" label={t.chat.shotAlt} />
        </Phone>
      </div>
    </div>

    <div
      class="fine relative overflow-hidden rounded-[20px] p-6 col-span-2 row-span-3"
    >
      <h3 class="mb-1.25 text-[17px] tracking-[-0.01em]">{t.sync.title}</h3>
      <p class="max-w-80 text-[13.5px]">{t.sync.body}</p>
      <SyncDevices lock={t.sync.lock} packet={t.sync.packet} />
    </div>

    <div
      class="fine relative overflow-hidden rounded-[20px] p-6 col-span-3 row-span-3"
      data-offline
    >
      <h3 class="mb-1.25 text-[17px] tracking-[-0.01em]">{t.offline.title}</h3>
      <p class="max-w-80 text-[13.5px]">{t.offline.body}</p>
      <AirplaneTyping airplane={t.offline.airplane} typed={t.offline.typed} />
    </div>

    <div
      class="fine relative overflow-hidden rounded-[20px] p-6 col-span-3 row-span-3"
      data-shortcuts
    >
      <h3 class="mb-1.25 text-[17px] tracking-[-0.01em]">{t.keyboard.title}</h3>
      <p class="max-w-80 text-[13.5px]">{t.keyboard.body}</p>
      <ShortcutWindow title={t.keyboard.window} keys={t.keyboard.keys} />
    </div>
  </div>
 </div>
  <img
    class="edge-mascot"
    src="/brand/mascot-sticker.webp"
    alt=""
    width="150"
    height="150"
    loading="lazy"
    decoding="async"
  />
</section>

<style>
  .shots {
    --phone-width: 196px;
    position: absolute;
    top: 30px;
    right: 28px;
    display: flex;
    align-items: flex-start;
  }

  .shots :global(.back) {
    margin-top: 44px;
    margin-right: -36px;
    rotate: -4deg;
  }

  .shots :global(.front) {
    rotate: 2deg;
  }

  @media (max-width: 768px) {
    .shots {
      top: 158px;
      right: 50%;
      transform: translateX(50%);
    }

    .shots :global(.back) {
      display: none;
    }

    .shots :global(.front) {
      rotate: 0deg;
    }
  }

  .edge-mascot {
    display: none;
  }

  @media (min-width: 1280px) {
    .edge-mascot {
      position: absolute;
      top: 120px;
      right: -38px;
      display: block;
      width: 150px;
      height: 150px;
      rotate: -14deg;
      animation: peek 5s ease-in-out infinite;
      pointer-events: none;
    }
  }

  @keyframes peek {
    50% {
      transform: translateX(-12px) rotate(4deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edge-mascot {
      animation: none;
    }
  }
</style>
