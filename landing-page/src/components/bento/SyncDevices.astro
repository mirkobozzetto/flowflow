---
import { Image } from "astro:assets";
import IphoneArt from "../art/IphoneArt.astro";
import MacbookArt from "../art/MacbookArt.astro";
import logo from "../../assets/logo.png";

interface Props {
  lock: string;
  packet: string;
}

const { lock, packet } = Astro.props;
const LOCK_PATH =
  "M7.5 10.5V8a4.5 4.5 0 0 1 9 0v2.5M6.5 10.5h11a1 1 0 0 1 1 1v7.5a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-7.5a1 1 0 0 1 1-1z";
---

<div class="sync-visual mt-7 flex items-center gap-3">
  <IphoneArt width={46}><Image src={logo} alt="" width={22} height={22} /></IphoneArt>
  <div class="sync-line">
    <span class="cipher" data-cipher={packet}>{packet}</span>
    <span class="sync-lock" role="img" aria-label={lock}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={LOCK_PATH}></path></svg>
    </span>
  </div>
  <MacbookArt width={104}><Image src={logo} alt="" width={26} height={26} /></MacbookArt>
</div>

<script>
  import "../../scripts/cipher.ts";
</script>

<style>
  .sync-line {
    position: relative;
    flex: 1;
    height: 2px;
    background: repeating-linear-gradient(
      90deg,
      var(--orange) 0 6px,
      transparent 6px 12px
    );
    background-size: 12px 100%;
    animation: dash 1.1s linear infinite;
  }

  .sync-lock {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: white;
    box-shadow:
      0 0 0 1px var(--orange-100),
      0 3px 8px -4px rgba(0, 0, 0, 0.2);
    transform: translate(-50%, -50%);
  }

  .sync-lock svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: var(--orange-dark);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cipher {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 1;
    padding: 1px 6px;
    border: 1px solid var(--orange-100);
    border-radius: 5px;
    background: white;
    color: var(--orange-dark);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .sync-line {
      animation: none;
    }

    .cipher {
      left: 25%;
    }
  }
</style>
