---
interface Shortcut {
  key: string;
  label: string;
}

interface Props {
  title: string;
  keys: Shortcut[];
}

const { title, keys } = Astro.props;
---

<div class="window" aria-hidden="true">
  <div class="bar"><i></i><i></i><i></i><span>{title}</span></div>
  <div class="screen">
    <div class="note" data-shortcut-card>
      <b data-shortcut-label>{keys[0]?.label}</b>
      <span></span><span class="short"></span>
    </div>
  </div>
</div>
<div class="keys">
  {keys.map((k) => <kbd data-label={k.label}>{k.key}</kbd>)}
</div>

<script>
  import "../../scripts/shortcuts.ts";
</script>

<style>
  .window {
    margin-top: 14px;
    overflow: hidden;
    border-radius: 10px;
    background: white;
    box-shadow:
      0 0 0 1px var(--rule),
      0 12px 22px -18px rgba(0, 0, 0, 0.4);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 24px;
    padding: 0 9px;
    border-bottom: 1px solid var(--hairline);
    background: #f6f6f7;
  }

  .bar i {
    width: 8px;
    height: 8px;
    border-radius: 9px;
    background: #ff5f57;
  }

  .bar i:nth-child(2) {
    background: #febc2e;
  }

  .bar i:nth-child(3) {
    background: #28c840;
  }

  .bar span {
    margin: 0 auto;
    font-size: 10.5px;
    font-weight: 600;
    color: black;
    transform: translateX(-16px);
  }

  .screen {
    display: grid;
    place-items: center;
    height: 84px;
  }

  .note {
    display: grid;
    gap: 6px;
    width: 72%;
    padding: 10px 12px;
    border-radius: 10px;
    background: var(--paper);
    box-shadow: var(--paper-edge);
  }

  .note b {
    font-size: 13px;
    font-weight: 600;
    color: black;
  }

  .note span {
    height: 5px;
    border-radius: 5px;
    background: var(--stone-200);
  }

  .note .short {
    width: 60%;
  }

  .note:global(.pop) {
    animation: pop 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.97);
    }
  }

  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 12px;
  }

  kbd {
    padding: 3px 9px;
    border: 1px solid var(--stone-200);
    border-bottom-width: 2px;
    border-radius: 7px;
    background: var(--warm-white);
    color: var(--stone-600);
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }

  kbd:global(.on) {
    border-color: var(--orange-100);
    border-bottom-width: 1px;
    background: var(--orange-50);
    color: var(--orange-dark);
    transform: translateY(1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .note:global(.pop) {
      animation: none;
    }
  }
</style>
