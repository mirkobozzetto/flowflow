---
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import HorizontalShowcase from "./HorizontalShowcase.astro";
import AgenticChapter from "./AgenticChapter.astro";
import TeamsChapter from "./TeamsChapter.astro";
import Bento from "./Bento.astro";
import Trust from "./Trust.astro";
import Faq from "./Faq.astro";
import Finale from "./Finale.astro";
import Footer from "./Footer.astro";
import WaveRule from "./WaveRule.astro";
import { section } from "../lib/i18n";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const showcase = section(lang, "showcase");
const { showcase: steps } = showcase;
---

<Nav lang={lang} />
<Hero lang={lang} />
<HorizontalShowcase lang={lang} label={steps.fig} panels={steps.panels} />
<AgenticChapter lang={lang} />
<TeamsChapter lang={lang} />
<WaveRule />
<Bento lang={lang} />
<Trust lang={lang} />
<WaveRule />
<Faq lang={lang} />
<Finale lang={lang} />
<Footer lang={lang} />
