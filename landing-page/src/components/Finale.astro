---
import { section } from "../lib/i18n";
import CtaButtons from "./CtaButtons.astro";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = section(lang, "footer");
---

<section class="container relative pt-40 pb-25 text-center">
  <h2
    class="text-[clamp(42px,7.4vw,96px)] leading-[0.98] tracking-[-0.037em] text-ink"
  >
    {t.finale.lead}<br /><em
      class="font-serif font-normal italic text-orange-dark"
      >{t.finale.accent}</em
    >
  </h2>
  <CtaButtons
    lang={lang}
    primary={t.finale.ctaPrimary}
    ghost={t.finale.ctaGhost}
  />
  <p class="mt-4 text-[13px]">
    {t.finale.note}
  </p>
</section>
