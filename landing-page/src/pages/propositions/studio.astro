---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Hero from "../../components/Hero.astro";
import HorizontalShowcase from "../../components/HorizontalShowcase.astro";
import AgenticChapter from "../../components/AgenticChapter.astro";
import TeamsChapter from "../../components/TeamsChapter.astro";
import Bento from "../../components/Bento.astro";
import Trust from "../../components/Trust.astro";
import Letter from "../../components/Letter.astro";
import Faq from "../../components/Faq.astro";
import Footer from "../../components/Footer.astro";
import DayFixed from "../../components/studio/DayFixed.astro";
import FinaleBlock from "../../components/studio/FinaleBlock.astro";
import StudioPanel from "../../components/studio/StudioPanel.astro";
import Fonts from "../../components/propositions/Fonts.astro";
import { section } from "../../lib/i18n";
import "../../styles/studio.css";

const lang = "fr";
const { showcase: steps } = section(lang, "showcase");
---

<Layout lang={lang}>
  <Fonts />
  <Nav lang={lang} />
  <Hero lang={lang} />
  <DayFixed />
  <HorizontalShowcase lang={lang} label={steps.fig} panels={steps.panels} />
  <AgenticChapter lang={lang} />
  <TeamsChapter lang={lang} />
  <Bento lang={lang} />
  <Trust lang={lang} />
  <Letter lang={lang} />
  <Faq lang={lang} />
  <FinaleBlock />
  <Footer lang={lang} />
  <StudioPanel />
</Layout>
