---
import Layout from "../../layouts/Layout.astro";
import Choice from "../../components/studio/Choice.astro";
import { section } from "../../lib/i18n";
import { APPLE_PATH } from "../../lib/icons";
import "../../styles/retouches.css";
import "../../styles/boutons.css";

const finale = section("fr", "footer").finale;
const NOTE = "Gratuit pour l'instant · tes clés, tes données";
const LAPTOP_PATH = "M5 5.5h14a1 1 0 0 1 1 1V16H4V6.5a1 1 0 0 1 1-1zM2 18.5h20";
const devices = ["iphone", "mac"] as const;

const macLabels = [
  { small: "Télécharger pour", big: "Mac" },
  { small: "Télécharger pour", big: "macOS" },
  { small: "Disponible sur", big: "Mac" },
  { small: "L'app pour", big: "Mac" },
];
---

<Layout lang="fr">
  <main class="opts">
    <h1>Boutons façon badge, aux couleurs de l'app</h1>
    <p class="opts-intro">
      Même forme que le badge d'Apple, en orange. Quatre libellés pour le Mac.
    </p>
    <p class="opts-note">
      Pomme pour l'App Store, ordinateur pour le Mac, texte centré.
    </p>

    <div class="opts-grid one-col">
      {
        macLabels.map((mac) => (
          <Choice group="Bouton Mac" name={`${mac.small} ${mac.big}`}>
            <div class="screens">
              {devices.map((d) => (
                <div class:list={["frame", d]}>
                  <span class="frame-label">{d === "iphone" ? "Sur iPhone" : "Sur Mac"}</span>
                  <div class="frame-body">
                    <h3>{finale.lead}<br />{finale.accent}</h3>
                    <div class="obadges">
                      <a class="obadge" href="#">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={APPLE_PATH}></path></svg>
                        <span><small>Télécharger dans</small>l'App Store</span>
                      </a>
                      <a class="obadge" href="#">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={LAPTOP_PATH}></path></svg>
                        <span><small>{mac.small}</small>{mac.big}</span>
                      </a>
                    </div>
                    <p class="fnote">{NOTE}</p>
                  </div>
                </div>
              ))}
            </div>
          </Choice>
        ))
      }
    </div>
  </main>

  <div class="opts-bar">
    <p data-count>Aucun choix</p>
    <button class="btn-primary" type="button" data-copy>Copier mes choix</button>
  </div>

  <script>
    const boxes = [...document.querySelectorAll<HTMLInputElement>("[data-keep]")];
    const count = document.querySelector<HTMLElement>("[data-count]");
    const kept = (): string[] =>
      boxes.filter((box) => box.checked).map((box) => box.dataset.keep ?? "");

    for (const box of boxes) {
      box.addEventListener("change", () => {
        const total = kept().length;
        if (count) count.textContent = total ? `${total} choix cochés` : "Aucun choix";
      });
    }

    document.querySelector("[data-copy]")?.addEventListener("click", () => {
      navigator.clipboard?.writeText(kept().join("\n"));
      if (count) count.textContent = "Choix copiés";
    });
  </script>
</Layout>
