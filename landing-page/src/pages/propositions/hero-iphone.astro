---
import Layout from "../../layouts/Layout.astro";
import Choice from "../../components/studio/Choice.astro";
import ParallaxScene from "../../components/ParallaxScene.astro";
import "../../styles/retouches.css";

const VARIANTS = [
  { id: "today", name: "Aujourd'hui", clip: "promo" },
  {
    id: "same-width",
    name: "Vraies proportions, même largeur (plus haut)",
    clip: "promo-tall",
  },
  {
    id: "same-height",
    name: "Vraies proportions, même hauteur (plus fin)",
    clip: "promo-tall",
  },
  {
    id: "bigger",
    name: "Vraies proportions, plus grand",
    clip: "promo-tall",
  },
];
---

<Layout lang="fr">
  <main class="opts">
    <h1>Taille de l'iPhone du haut de page</h1>
    <p class="opts-intro">
      Aujourd'hui l'écran suit la vidéo en 9:16, plus large qu'un vrai iPhone.
      Les trois autres prennent le format d'un iPhone actuel, vidéo entière.
    </p>
    <div class="opts-grid one-col">
      {
        VARIANTS.map((v) => (
          <Choice group="iPhone du haut" name={v.name} current={v.id === "today"}>
            <div class:list={["hero-wrap", `v-${v.id}`]}>
              <ParallaxScene lang="fr" clip={v.clip} />
            </div>
          </Choice>
        ))
      }
    </div>
  </main>

  <div class="opts-bar">
    <p data-count>Aucun choix</p>
    <button class="btn-primary" type="button" data-copy>Copier mes choix</button>
  </div>

  <script>
    const boxes = [...document.querySelectorAll<HTMLInputElement>("[data-keep]")];
    const count = document.querySelector<HTMLElement>("[data-count]");
    const kept = (): string[] =>
      boxes.filter((box) => box.checked).map((box) => box.dataset.keep ?? "");
    for (const box of boxes) {
      box.addEventListener("change", () => {
        const total = kept().length;
        if (count) count.textContent = total ? `${total} choix cochés` : "Aucun choix";
      });
    }
    document.querySelector("[data-copy]")?.addEventListener("click", () => {
      navigator.clipboard?.writeText(kept().join("\n"));
      if (count) count.textContent = "Choix copiés";
    });
  </script>
</Layout>

<style>
  .hero-wrap {
    width: 100%;
    padding-bottom: 72px;
  }

  .hero-wrap:not(.v-today) :global(.iphone) {
    --screen-ratio: 940 / 2038;
  }

  /* Same height as today: 534 px tall at the widest, so 256 px wide. */
  .v-same-height :global(.iphone) {
    --phone-width: clamp(157px, 19vw, 256px);
  }

  .v-bigger {
    padding-top: 64px;
  }

  .v-bigger :global(.iphone) {
    --phone-width: clamp(220px, 27vw, 360px);
  }
</style>
