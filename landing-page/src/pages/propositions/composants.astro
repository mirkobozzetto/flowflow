---
import Layout from "../../layouts/Layout.astro";
import ActionCard from "../../components/ActionCard.astro";
import ConnectorChips from "../../components/ConnectorChips.astro";
import Offer from "../../components/Offer.astro";
import Choice from "../../components/studio/Choice.astro";
import { section } from "../../lib/i18n";
import "../../styles/composants.css";

const { connectors, connectorsLabel, actions } = section("fr", "agentic");
const teams = section("fr", "teams");
const action = actions[0] ?? { you: "", then: "" };

const offers = [
  { id: "actuel", name: "Filet noir", current: true, css: "" },
  { id: "air", name: "Ombre douce, sans filet", css: "v-air" },
  { id: "gris", name: "Filet gris doux", css: "v-gris" },
  { id: "orange", name: "Filet orange très clair", css: "v-orange" },
  { id: "pale", name: "Fond orange très pâle", css: "v-pale" },
];

const fonts = [
  { name: "Italique fine", current: true, css: "" },
  { name: "Italique plus grande", css: "t-grand" },
  { name: "Droit et demi-gras", css: "t-droit" },
  { name: "Droit et gras", css: "t-mix" },
];

const lines = [
  { name: "Ligne fine", kind: "sine", speed: 0.7 },
  { name: "Onde de voix", kind: "voice", speed: 1 },
  { name: "Barres fines", kind: "bars", speed: 0.8 },
];

const logos = [
  ["Notion", "notion"],
  ["Slack", "slack"],
  ["HubSpot", "hubspot"],
  ["Outlook", "microsoftoutlook"],
  ["Teams", ""],
  ["OneDrive", "microsoftonedrive"],
  ["Sellsy", ""],
  ["Axonaut", ""],
  ["Pennylane", ""],
  ["Zapier", "zapier"],
  ["Make", "make"],
  ["n8n", "n8n"],
];

const shortNames = connectors.map((c) => ({
  ...c,
  name: c.name.replace("Google ", ""),
}));

const spoken = "Rappelle-moi d'envoyer la proposition jeudi à 9 h.".split(" ");
---

<Layout lang="fr">
  <main class="opts">
    <h1>Composants à choisir</h1>
    <p class="opts-intro">
      Ta page ne bouge pas. Ici, chaque idée reste une suggestion. Coche ce que
      tu veux garder, et copie tes choix en bas.
    </p>

    <section>
      <h2>Bord des blocs</h2>
      <div class="opts-grid five">
        {
          offers.map((o) => (
            <Choice group="Bord" name={o.name} current={o.current}>
              <div class={o.css}>
                <Offer
                  tone="white"
                  title={teams.solo.title}
                  body={teams.solo.body}
                  points={teams.solo.points}
                  cta={teams.solo.cta}
                  href="#"
                />
              </div>
            </Choice>
          ))
        }
      </div>
    </section>

    <section>
      <h2>Connecteurs, sans orphelin</h2>
      <div class="opts-grid wide">
        <Choice group="Connecteurs" name="Sur deux lignes" current>
          <div class="on-orange demo-orange" style="padding:18px;border-radius:12px">
            <ConnectorChips label={connectorsLabel} connectors={connectors} />
          </div>
        </Choice>
        <Choice group="Connecteurs" name="Grille 3 x 2">
          <div class="on-orange demo-orange" style="padding:18px;border-radius:12px">
            <ConnectorChips
              label={connectorsLabel}
              connectors={connectors}
              variant="grid"
            />
          </div>
        </Choice>
        <Choice group="Connecteurs" name="Une ligne serrée">
          <div class="on-orange demo-orange" style="padding:18px;border-radius:12px">
            <ConnectorChips
              label={connectorsLabel}
              connectors={shortNames}
              variant="tight"
            />
          </div>
        </Choice>
        <Choice group="Connecteurs" name="Logos seuls">
          <div class="on-orange demo-orange" style="padding:18px;border-radius:12px">
            <ConnectorChips
              label={connectorsLabel}
              connectors={connectors}
              variant="logos"
            />
          </div>
        </Choice>
      </div>
    </section>

    <section>
      <h2>Connecteurs à venir ou sur commande</h2>
      <p class="opts-note">
        Aucun n'existe encore. Trois marques sont en texte seul : je n'ai pas
        leur logo.
      </p>
      <div class="opts-grid wide">
        <Choice group="À venir" name="Rangée « à venir »">
          <div class="on-orange demo-orange" style="padding:18px;border-radius:12px">
            <p class="lbl-small">À venir</p>
            <div class="soon-row">
              {
                logos.map(([name, file]) => (
                  <span>
                    {file && (
                      <img src={`/propositions/logos/${file}.svg`} alt="" />
                    )}
                    {name}
                  </span>
                ))
              }
            </div>
          </div>
        </Choice>
        <Choice group="À venir" name="Une phrase « sur commande »">
          <div class="on-orange demo-orange" style="padding:18px;border-radius:12px">
            <p class="lbl-small">
              Notion, Slack, HubSpot, Outlook, Sellsy, Pennylane et d'autres
              arrivent.
            </p>
            <p>Ton outil n'y est pas ? On le branche sur commande.</p>
          </div>
        </Choice>
      </div>
    </section>

    <section>
      <h2>Texte des cartes</h2>
      <div class="opts-grid">
        {
          fonts.map((f) => (
            <Choice group="Texte des cartes" name={f.name} current={f.current}>
              <div class={f.css}>
                <ActionCard you={action.you} result={action.then} />
              </div>
            </Choice>
          ))
        }
      </div>
    </section>

    <section>
      <h2>Ligne d'onde entre les sections</h2>
      <div class="opts-grid">
        {
          lines.map((l) => (
            <Choice group="Ligne d'onde" name={l.name}>
              <canvas class="stage-wave" data-wave={l.kind} data-speed={l.speed} />
            </Choice>
          ))
        }
      </div>
    </section>

    <section>
      <h2>Onde sous « voix »</h2>
      <div class="opts-grid">
        {
          lines.map((l) => (
            <Choice group="Onde sous voix" name={l.name}>
              <p class="demo-title">
                de <em>
                  voix
                  <canvas data-wave={l.kind} data-speed={l.speed} />
                </em>
              </p>
            </Choice>
          ))
        }
      </div>
    </section>

    <section>
      <h2>Capsule vocale de l'app</h2>
      <div class="opts-grid">
        {
          [
            ["Noire, comme l'app", "noir", "#ffffff"],
            ["Blanche", "blanc", "#ff5c00"],
            ["Orange", "orange", "#ffffff"],
          ].map(([name, tone, color]) => (
            <Choice group="Capsule" name={name ?? ""}>
              <div class="capsule" data-tone={tone}>
                <canvas data-wave="bars" data-color={color} />
                <b>0:14</b>
                <i />
              </div>
            </Choice>
          ))
        }
      </div>
    </section>

    <section>
      <h2>Onde dans les boutons</h2>
      <p class="opts-note">Passe la souris sur chaque bouton.</p>
      <div class="opts-grid">
        <Choice group="Boutons" name="Sans onde" current>
          <a class="btn-primary" href="#" style="align-self:center">App Store</a>
        </Choice>
        <Choice group="Boutons" name="Barres à gauche">
          <a class="btn-primary btn-eq" href="#" style="align-self:center">
            <span class="eq"><i></i><i></i><i></i><i></i></span>App Store
          </a>
        </Choice>
        <Choice group="Boutons" name="Barres à droite">
          <a class="btn-primary btn-eq" href="#" style="align-self:center">
            App Store<span class="eq"><i></i><i></i><i></i><i></i></span>
          </a>
        </Choice>
        <Choice group="Boutons" name="Trait d'onde dessous">
          <a class="btn-primary btn-line" href="#" style="align-self:center">
            App Store
            <canvas data-wave="sine" data-color="#ffffff" data-speed="2"></canvas>
          </a>
        </Choice>
      </div>
    </section>

    <section>
      <h2>Texte qui se transcrit</h2>
      <div class="opts-grid">
        {
          [
            ["Du gris vers le noir", "gris"],
            ["Mot en cours en orange", "bloc"],
            ["Trait sous le mot", "trait"],
          ].map(([name, style]) => (
            <Choice group="Transcription" name={name ?? ""}>
              <p class="spoken" data-spoken data-style={style}>
                {spoken.map((word) => <span>{word} </span>)}
              </p>
            </Choice>
          ))
        }
      </div>
    </section>

    <section>
      <h2>Barre de progression en onde</h2>
      <p class="opts-note">Elle avance quand tu fais défiler la page.</p>
      <div class="opts-grid">
        <Choice group="Progression" name="Trait droit" current>
          <div class="progress-demo">
            <div style="height:2px;top:12px;background:#ff5c00"></div>
          </div>
        </Choice>
        <Choice group="Progression" name="Trait en onde">
          <div class="progress-demo">
            <div><canvas data-wave="sine" data-speed="1"></canvas></div>
          </div>
        </Choice>
        <Choice group="Progression" name="Petites barres">
          <div class="progress-demo">
            <div><canvas data-wave="bars" data-speed="1"></canvas></div>
          </div>
        </Choice>
      </div>
    </section>

    <section>
      <h2>Ondes dans le bloc orange</h2>
      <div class="opts-grid">
        <Choice group="Bloc orange" name="Sans onde" current>
          <div class="tone-block on-orange"><p>Du dire au faire</p></div>
        </Choice>
        <Choice group="Bloc orange" name="Lignes ton sur ton">
          <div class="tone-block on-orange">
            <canvas data-wave="tone" data-color="#ffffff" data-speed="0.5" data-line="1"
            ></canvas>
            <p>Du dire au faire</p>
          </div>
        </Choice>
        <Choice group="Bloc orange" name="Onde de voix">
          <div class="tone-block on-orange">
            <canvas data-wave="voice" data-color="rgba(255,255,255,0.38)" data-speed="0.6"
            ></canvas>
            <p>Du dire au faire</p>
          </div>
        </Choice>
        <Choice group="Bloc orange" name="Barres fines">
          <div class="tone-block on-orange">
            <canvas data-wave="bars" data-color="rgba(255,255,255,0.22)" data-speed="0.5"
            ></canvas>
            <p>Du dire au faire</p>
          </div>
        </Choice>
      </div>
    </section>
  </main>

  <div class="opts-bar">
    <p data-count>Aucun choix</p>
    <button class="btn-primary" type="button" data-copy>Copier mes choix</button>
  </div>

  <script>
    import "../../scripts/waves.ts";

    const boxes = [...document.querySelectorAll<HTMLInputElement>("[data-keep]")];
    const count = document.querySelector<HTMLElement>("[data-count]");
    const kept = (): string[] =>
      boxes.filter((box) => box.checked).map((box) => box.dataset.keep ?? "");

    for (const box of boxes) {
      box.addEventListener("change", () => {
        const total = kept().length;
        if (count) {
          count.textContent = total
            ? `${total} choix cochés`
            : "Aucun choix";
        }
      });
    }

    document.querySelector("[data-copy]")?.addEventListener("click", () => {
      navigator.clipboard?.writeText(kept().join("\n"));
      if (count) count.textContent = "Choix copiés";
    });

    const sentences = document.querySelectorAll<HTMLElement>("[data-spoken]");
    let index = 0;
    setInterval(() => {
      for (const sentence of sentences) {
        const words = [...sentence.querySelectorAll("span")];
        const at = index % (words.length + 3);
        words.forEach((word, i) => {
          word.classList.toggle("on", i <= at);
          word.classList.toggle("now", i === at);
        });
      }
      index += 1;
    }, 420);

    const root = document.documentElement;
    addEventListener(
      "scroll",
      () => {
        const max = root.scrollHeight - innerHeight;
        root.style.setProperty("--p", String(max > 0 ? scrollY / max : 0));
      },
      { passive: true },
    );
  </script>
</Layout>
