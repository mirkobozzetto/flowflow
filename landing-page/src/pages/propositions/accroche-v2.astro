---
import Layout from "../../layouts/Layout.astro";
import Choice from "../../components/studio/Choice.astro";
import { APPLE_PATH } from "../../lib/icons";
import "../../styles/retouches.css";
import "../../styles/boutons.css";

const H1 = "À portée de voix";
const LEAD = "De l'idée à l'action, sans clavier";
const EXAMPLES = ["Mail", "devis", "rendez-vous", "ou autre chose"];
const REST = "ton agent prépare tout,";
const GO = "tu n'as qu'à dire go";
const VARIANTS = [
  { id: "today", name: "Aujourd'hui" },
  { id: "break", name: "Coupure choisie, deux lignes nettes" },
  { id: "single", name: "Une seule ligne, plus petite" },
  { id: "chips", name: "Exemples en pastilles" },
  { id: "bold", name: "Exemples en gras, go surligné" },
  { id: "stack", name: "Exemples au-dessus, en petit" },
];
---

<Layout lang="fr">
  <main class="opts">
    <h1>Bloc sous le titre, version 2</h1>
    <p class="opts-intro">Mêmes mots, six mises en forme. Coche ce que tu gardes.</p>
    <div class="opts-grid wide">
      {
        VARIANTS.map((v) => (
          <Choice group="Bloc" name={v.name} current={v.id === "today"}>
            <div class:list={["hero-mini", `v-${v.id}`]}>
              <p class="h1">{H1}</p>
              <div class="lines">
                <p class="lead">{LEAD}</p>
                {v.id === "chips" && (
                  <>
                    <ul class="chips">
                      {EXAMPLES.map((e) => <li>{e.replace(/^ou /, "")}</li>)}
                    </ul>
                    <p class="line">{REST} <mark class="hl go">{GO}</mark></p>
                  </>
                )}
                {v.id === "stack" && (
                  <>
                    <p class="examples">{EXAMPLES.join(" · ").replace(" · ou ", " · ")}</p>
                    <p class="line">Ton agent prépare tout, <mark class="hl go">{GO}</mark></p>
                  </>
                )}
                {v.id === "break" && (
                  <p class="line">
                    <span class="row">Mail, devis, rendez-vous ou autre chose :</span>
                    <span class="row">{REST} <mark class="hl go">{GO}</mark></span>
                  </p>
                )}
                {v.id === "bold" && (
                  <p class="line">
                    <b>Mail, devis, rendez-vous</b> ou autre chose : {REST}{" "}
                    <mark class="hl go">{GO}</mark>
                  </p>
                )}
                {(v.id === "today" || v.id === "single") && (
                  <p class="line">
                    Mail, devis, rendez-vous ou autre chose : {REST}{" "}
                    <mark class="hl go">{GO}</mark>
                  </p>
                )}
              </div>
              <div class="obadges">
                <a class="obadge" href="#">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={APPLE_PATH} /></svg>
                  <span><small>Télécharger dans</small>l'App Store</span>
                </a>
                <a class="obadge white" href="#">
                  <span><small>Télécharger pour</small>macOS</span>
                </a>
              </div>
            </div>
          </Choice>
        ))
      }
    </div>
  </main>

  <div class="opts-bar">
    <p data-count>Aucun choix</p>
    <button class="btn-primary" type="button" data-copy>Copier mes choix</button>
  </div>

  <script>
    const boxes = [...document.querySelectorAll<HTMLInputElement>("[data-keep]")];
    const count = document.querySelector<HTMLElement>("[data-count]");
    const kept = (): string[] =>
      boxes.filter((box) => box.checked).map((box) => box.dataset.keep ?? "");
    for (const box of boxes) {
      box.addEventListener("change", () => {
        const total = kept().length;
        if (count) count.textContent = total ? `${total} choix cochés` : "Aucun choix";
      });
    }
    document.querySelector("[data-copy]")?.addEventListener("click", () => {
      navigator.clipboard?.writeText(kept().join("\n"));
      if (count) count.textContent = "Choix copiés";
    });
  </script>
</Layout>

<style>
  .hero-mini {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 34px 12px 30px;
    text-align: center;
  }

  .h1 {
    color: var(--ink);
    font-size: clamp(34px, 4.4vw, 50px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .lines {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 26px 0;
  }

  .lead {
    color: var(--ink);
    font-size: clamp(20px, 2.2vw, 24px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .line {
    max-width: 30em;
    margin-top: 4px;
    font-size: clamp(17px, 1.9vw, 20px);
    line-height: 1.4;
    text-wrap: balance;
  }

  .go {
    font-weight: 600;
  }

  .v-break .row {
    display: block;
  }

  .v-single .line {
    max-width: 44em;
    margin-top: 6px;
    font-size: 15px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
    margin: 12px 0 8px;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 4px 11px;
    border-radius: 99px;
    background: var(--paper-button);
    box-shadow: var(--paper-edge);
    font-size: 14px;
    font-weight: 600;
  }

  .examples {
    order: -1;
    margin-bottom: 8px;
    color: var(--orange-dark);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .v-stack .lines {
    margin-top: 22px;
  }

  .obadge.white {
    background: white;
    color: black;
    box-shadow: 0 0 0 1px var(--rule);
  }
</style>
