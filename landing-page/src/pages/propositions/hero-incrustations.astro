---
import Layout from "../../layouts/Layout.astro";
import Choice from "../../components/studio/Choice.astro";
import Hero from "../../components/Hero.astro";
import InkIcons from "../../components/art/InkIcons.astro";
import HandNote from "../../components/art/HandNote.astro";
import { section } from "../../lib/i18n";
import "../../styles/retouches.css";

const trust = section("fr", "trust");
const PILLS = ["Mail", "Devis", "Rendez-vous"];
const VARIANTS = [
  { id: "today", name: "Aujourd'hui", icons: false, pills: false, note: false },
  { id: "icons", name: "Icônes en filigrane", icons: true, pills: false, note: false },
  { id: "pills", name: "Pastilles Mail, Devis, Rendez-vous", icons: false, pills: true, note: false },
  { id: "note", name: "Note manuscrite orange", icons: false, pills: false, note: true },
  { id: "all", name: "Les trois ensemble", icons: true, pills: true, note: true },
];
---

<Layout lang="fr">
  <main class="opts">
    <h1>Incrustations du haut de page</h1>
    <p class="opts-intro">
      Le premier écran tel qu'on arrive dessus, avec chaque incrustation.
      La note reprend « {trust.costTitle} », déjà sur la page.
    </p>
    <div class="opts-grid one-col">
      {
        VARIANTS.map((v) => (
          <Choice group="Haut de page" name={v.name} current={v.id === "today"}>
            <div class="hero-box">
              <Hero lang="fr" />
              {v.icons && (
                <>
                  <InkIcons set="left" />
                  <InkIcons set="right" />
                </>
              )}
              {v.pills && (
                <ul class="pills" aria-hidden="true">
                  {PILLS.map((p, i) => (
                    <li class={`pill p${i}`}>{p}</li>
                  ))}
                </ul>
              )}
              {v.note && (
                <HandNote text={trust.costTitle} arrow="up-left" class="note-free" />
              )}
            </div>
          </Choice>
        ))
      }
    </div>
  </main>

  <div class="opts-bar">
    <p data-count>Aucun choix</p>
    <button class="btn-primary" type="button" data-copy>Copier mes choix</button>
  </div>

  <script>
    const boxes = [...document.querySelectorAll<HTMLInputElement>("[data-keep]")];
    const count = document.querySelector<HTMLElement>("[data-count]");
    const kept = (): string[] =>
      boxes.filter((box) => box.checked).map((box) => box.dataset.keep ?? "");
    for (const box of boxes) {
      box.addEventListener("change", () => {
        const total = kept().length;
        if (count) count.textContent = total ? `${total} choix cochés` : "Aucun choix";
      });
    }
    document.querySelector("[data-copy]")?.addEventListener("click", () => {
      navigator.clipboard?.writeText(kept().join("\n"));
      if (count) count.textContent = "Choix copiés";
    });
  </script>
</Layout>

<style>
  .hero-box {
    position: relative;
    width: 100%;
  }

  .hero-box :global(.stage) {
    display: none;
  }

  /* The draft page's own h1 style must not shrink the hero title. */
  .hero-box :global(h1) {
    font-size: clamp(50px, 8.4vw, 104px);
    line-height: 0.99;
  }

  .pills {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pill {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 13px 6px 10px;
    border-radius: 99px;
    background: var(--paper-button);
    box-shadow: var(--paper-edge), var(--paper-lift);
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    animation: pillFloat 6s ease-in-out infinite;
  }

  .pill::before {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: var(--orange-dark);
    content: "";
  }

  .p0 {
    top: 232px;
    right: calc(50% + 120px);
    rotate: -5deg;
  }

  .p1 {
    top: 300px;
    left: calc(50% + 122px);
    rotate: 4deg;
    animation-delay: -2s;
  }

  .p2 {
    top: 372px;
    right: calc(50% + 136px);
    rotate: 3deg;
    animation-delay: -4s;
  }

  @keyframes pillFloat {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -6px;
    }
  }

  .hero-box :global(.note-free) {
    top: 726px;
    left: calc(50% + 226px);
  }
</style>
