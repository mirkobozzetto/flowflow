---
import Layout from "../../layouts/Layout.astro";
import Choice from "../../components/studio/Choice.astro";
import "../../styles/composants.css";

const DEFAULT_COUNT = 8;

const phrases = [
  { say: "Agenda : appel client à 10 h, puis deux heures sans Slack.", tag: "Agenda · 10 h", title: "Appel client" },
  { say: "Rappelle-moi d'envoyer le devis au client avant midi.", tag: "Rappel · 11 h 45", title: "Devis client" },
  { say: "Compte rendu : il veut « juste un petit bouton ». Ça fait trois écrans.", tag: "Réunion", title: "Le petit bouton" },
  { say: "Rappelle-moi de facturer les « petits ajustements » de mardi.", tag: "Facturation", title: "Petits ajustements" },
  { say: "Note FlowFlow : la build iPhone passe du premier coup. Ferris est fier.", tag: "FlowFlow", title: "Build iPhone" },
  { say: "Bloque vendredi après-midi pour la review Apple, rien d'autre.", tag: "Agenda · vendredi", title: "Review Apple" },
  { say: "Note : ne jamais publier un vendredi soir. Même pas celui-là.", tag: "Leçon", title: "Vendredi soir" },
  { say: "Rappelle-moi de fermer l'ordi à 19 h. Vraiment, cette fois.", tag: "Rappel · 19 h", title: "Fermer l'ordi" },
  { say: "Déplace le point d'équipe à 14 h, le client a décalé.", tag: "Agenda · 14 h", title: "Point d'équipe" },
  { say: "Rappelle-moi d'envoyer la proposition jeudi à 9 h.", tag: "Rappel · jeudi 9 h", title: "Proposition" },
  { say: "Rappelle-moi de relancer la facture de septembre lundi.", tag: "Rappel · lundi", title: "Relance facture" },
  { say: "Le client valide la maquette. Il veut juste le logo plus grand.", tag: "Réunion", title: "Maquette validée" },
  { say: "Décision : on livre la v1 sans le mode sombre. Personne ne pleure.", tag: "Réunion", title: "V1 sans mode sombre" },
  { say: "Note : trois heures sur un bug d'une ligne. Je facture la ligne ?", tag: "Facturation", title: "Bug d'une ligne" },
  { say: "Note FlowFlow : le mode avion marche, testé dans le train.", tag: "FlowFlow", title: "Mode avion" },
  { say: "Rappelle-moi de répondre aux avis App Store ce soir.", tag: "Rappel · ce soir", title: "Avis App Store" },
  { say: "Leçon du jour : relire le devis avant de l'envoyer. Les deux fois.", tag: "Leçon", title: "Relire le devis" },
  { say: "Note : boire de l'eau. Le café ne compte pas.", tag: "Humain", title: "Boire de l'eau" },
  { say: "Rappelle-moi d'appeler ma mère dimanche. Elle demande si l'app est finie.", tag: "Rappel · dimanche", title: "Appeler maman" },
  { say: "Agenda : pause déjeuner à 13 h. Loin de l'écran.", tag: "Agenda · 13 h", title: "Pause déjeuner" },
];

const modes = [
  { id: "prompter", name: "Prompteur qui défile", note: "Le texte défile tout du long, le mot dit s'allume, le rythme varie comme une voix." },
  { id: "pile", name: "Pile sous la capsule", note: "Chaque phrase devient une carte qui se pose en haut de la pile." },
  { id: "side", name: "Colonne de notes à côté", note: "Les cartes arrivent dans une colonne, comme la liste de l'app." },
  { id: "ticker", name: "Ruban qui défile", note: "Les cartes défilent en ruban sous la capsule." },
];
---

<Layout lang="fr">
  <main class="opts">
    <h1>La démo de la fenêtre Mac</h1>
    <p class="opts-intro">
      Coche les phrases que tu gardes : les trois animations tournent tout de
      suite avec elles. Sans choix, elles prennent les huit premières.
    </p>

    <section>
      <h2>L'animation</h2>
      <div class="opts-grid wide">
        {
          modes.map((m) => (
            <Choice group="Animation" name={m.name}>
              {m.id === "prompter" ? (
                <div class="demo demo-prompter" data-demo="prompter">
                  <div class="scroll" data-scroll>
                    <div class="column" data-column />
                  </div>
                  <canvas class="big-wave" data-wave="bars" data-speed="2.4" />
                </div>
              ) : (
              <div class={`demo demo-${m.id}`} data-demo={m.id}>
                <div class="talk">
                  <p class="line" data-line />
                  <div class="pill" aria-hidden="true">
                    <canvas data-wave="bars" data-color="#ffffff" />
                    <b>0:14</b>
                    <i />
                  </div>
                </div>
                <ul class="notes" data-notes />
              </div>
              )}
              <p class="opts-note">{m.note}</p>
            </Choice>
          ))
        }
      </div>
    </section>

    <section>
      <h2>Les phrases</h2>
      <p class="opts-note">Une journée de freelance qui construit FlowFlow.</p>
      <div class="opts-grid">
        {
          phrases.map((p, i) => (
            <Choice group="Phrase" name={p.title}>
              <div
                class="phrase"
                data-phrase={JSON.stringify(p)}
                data-default={i < DEFAULT_COUNT ? "" : undefined}
              >
                <p class="say">« {p.say} »</p>
                <p class="card-preview">
                  <span>{p.tag}</span>
                  <b>{p.title}</b>
                </p>
              </div>
            </Choice>
          ))
        }
      </div>
    </section>
  </main>

  <div class="opts-bar">
    <p data-count>Aucun choix</p>
    <button class="btn-primary" type="button" data-copy>Copier mes choix</button>
  </div>

  <script>
    interface Phrase {
      say: string;
      tag: string;
      title: string;
    }

    const STEP_MS = 230;
    const HOLD_MS = 900;
    const MAX_NOTES = { pile: 3, side: 4, ticker: 4 } as const;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const boxes = [...document.querySelectorAll<HTMLInputElement>("[data-keep]")];
    const count = document.querySelector<HTMLElement>("[data-count]");
    const kept = (): string[] =>
      boxes.filter((b) => b.checked).map((b) => b.dataset.keep ?? "");

    const readPhrase = (el: Element): Phrase =>
      JSON.parse((el as HTMLElement).dataset.phrase ?? "{}") as Phrase;

    function chosenPhrases(): Phrase[] {
      const checked = [...document.querySelectorAll(".phrase")].filter((el) =>
        el.closest(".choice")?.querySelector<HTMLInputElement>("input")?.checked,
      );
      const pool = checked.length
        ? checked
        : [...document.querySelectorAll(".phrase[data-default]")];
      return pool.map(readPhrase);
    }

    function noteCard(p: Phrase): HTMLLIElement {
      const li = document.createElement("li");
      const tag = document.createElement("span");
      const title = document.createElement("b");
      tag.textContent = p.tag;
      title.textContent = p.title;
      li.append(tag, title);
      return li;
    }

    function addNote(list: HTMLElement, mode: keyof typeof MAX_NOTES, p: Phrase) {
      const card = noteCard(p);
      if (mode === "pile") list.prepend(card);
      else list.append(card);
      requestAnimationFrame(() => card.classList.add("in"));
      while (list.children.length > MAX_NOTES[mode]) {
        (mode === "pile" ? list.lastElementChild : list.firstElementChild)?.remove();
      }
    }

    function run(demo: HTMLElement) {
      const mode = demo.dataset.demo as keyof typeof MAX_NOTES;
      const line = demo.querySelector<HTMLElement>("[data-line]");
      const list = demo.querySelector<HTMLElement>("[data-notes]");
      if (!line || !list) return;
      let index = 0;

      if (reduced) {
        for (const p of chosenPhrases().slice(0, MAX_NOTES[mode])) {
          addNote(list, mode, p);
        }
        line.textContent = chosenPhrases()[0]?.say ?? "";
        return;
      }

      const speak = () => {
        const all = chosenPhrases();
        const phrase = all[index % all.length];
        index += 1;
        if (!phrase) return;
        line.replaceChildren(
          ...phrase.say.split(" ").map((word) => {
            const span = document.createElement("span");
            span.textContent = `${word} `;
            return span;
          }),
        );
        const words = [...line.children];
        let at = 0;
        const timer = setInterval(() => {
          words.forEach((w, i) => w.classList.toggle("now", i === at));
          at += 1;
          if (at > words.length) {
            clearInterval(timer);
            addNote(list, mode, phrase);
            setTimeout(speak, HOLD_MS);
          }
        }, STEP_MS);
      };
      speak();
    }

    const PAUSE_AT = /[.,:?!»]$/;
    const WORD_MS = 140;
    const LETTER_MS = 16;
    const PAUSE_MS = 420;

    function runPrompter(demo: HTMLElement) {
      const view = demo.querySelector<HTMLElement>("[data-scroll]");
      const column = demo.querySelector<HTMLElement>("[data-column]");
      const wave = demo.querySelector<HTMLCanvasElement>("canvas");
      if (!view || !column) return;
      let words: HTMLSpanElement[] = [];
      const build = () => {
        words = [];
        column.replaceChildren(
          ...chosenPhrases().map((p) => {
            const line = document.createElement("p");
            for (const word of p.say.split(" ")) {
              const span = document.createElement("span");
              span.textContent = `${word} `;
              line.append(span);
              words.push(span);
            }
            return line;
          }),
        );
      };
      build();
      if (reduced) return;
      let at = 0;
      const step = () => {
        if (at >= words.length) {
          at = 0;
          build();
        }
        const word = words[at];
        if (!word) return;
        words.forEach((w, i) => {
          w.classList.toggle("said", i < at);
          w.classList.toggle("now", i === at);
        });
        const line = word.parentElement as HTMLElement;
        const offset =
          line.offsetTop + line.offsetHeight / 2 - view.clientHeight / 2;
        column.style.transform = `translateY(${-Math.max(0, offset)}px)`;
        const text = word.textContent?.trim() ?? "";
        const pause = PAUSE_AT.test(text);
        if (wave) wave.dataset.speed = pause ? "0.7" : String(2 + Math.random() * 1.4);
        const ms =
          (WORD_MS + text.length * LETTER_MS) * (0.7 + Math.random() * 0.6) +
          (pause ? PAUSE_MS : 0);
        at += 1;
        setTimeout(step, ms);
      };
      step();
    }

    for (const demo of document.querySelectorAll<HTMLElement>("[data-demo]")) {
      if (demo.dataset.demo === "prompter") runPrompter(demo);
      else run(demo);
    }

    for (const box of boxes) {
      box.addEventListener("change", () => {
        const total = kept().length;
        if (count) count.textContent = total ? `${total} choix cochés` : "Aucun choix";
      });
    }

    document.querySelector("[data-copy]")?.addEventListener("click", () => {
      navigator.clipboard?.writeText(kept().join("\n"));
      if (count) count.textContent = "Choix copiés";
    });
  </script>
</Layout>

<style>
  .demo {
    display: grid;
    gap: 16px;
    min-height: 300px;
    padding: 20px;
    border-radius: 16px;
    background: var(--paper);
    box-shadow: var(--paper-edge);
    overflow: hidden;
  }

  .demo-side {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
  }

  .demo-prompter {
    gap: 10px;
    min-height: 0;
  }

  .scroll {
    height: 250px;
    overflow: hidden;
    mask-image: linear-gradient(
      transparent,
      black 28%,
      black 72%,
      transparent
    );
  }

  .column {
    transition: transform 0.45s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  .column :global(p) {
    margin: 0 0 14px;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.28;
    letter-spacing: -0.02em;
    color: rgba(0, 0, 0, 0.26);
  }

  .column :global(span.said) {
    color: black;
  }

  .column :global(span.now) {
    border-radius: 4px;
    background: var(--orange-dark);
    color: white;
  }

  .big-wave {
    display: block;
    width: 100%;
    height: 56px;
  }

  .talk {
    display: grid;
    gap: 14px;
    justify-items: center;
    text-align: center;
  }

  .line {
    min-height: 2.6em;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .line :global(span.now) {
    border-radius: 4px;
    background: var(--orange-dark);
    color: white;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 6px 0 14px;
    border-radius: 99px;
    background: var(--ink-2);
    color: white;
  }

  .pill canvas {
    width: 110px;
    height: 22px;
  }

  .pill b {
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .pill i {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 99px;
    background: var(--orange-dark);
  }

  .pill i::after {
    content: "";
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: white;
  }

  .notes {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .demo-ticker .notes {
    grid-auto-flow: column;
    grid-auto-columns: minmax(150px, 1fr);
  }

  .notes :global(li) {
    display: grid;
    gap: 3px;
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--paper-button);
    box-shadow: var(--paper-edge);
    text-align: left;
    opacity: 0;
    transform: translateY(-10px) scale(0.98);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .demo-side .notes :global(li),
  .demo-ticker .notes :global(li) {
    transform: translateY(10px);
  }

  .notes :global(li.in) {
    opacity: 1;
    transform: none;
  }

  .notes :global(span),
  .card-preview span {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--orange-dark);
  }

  .notes :global(b),
  .card-preview b {
    font-size: 14.5px;
    font-weight: 600;
  }

  .phrase {
    display: grid;
    gap: 12px;
  }

  .say {
    font-size: 16.5px;
    font-weight: 600;
    line-height: 1.35;
    text-wrap: pretty;
  }

  .card-preview {
    display: grid;
    gap: 2px;
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--paper-button);
    box-shadow: var(--paper-edge);
  }

  @media (max-width: 640px) {
    .demo-side {
      grid-template-columns: 1fr;
    }

    .demo-ticker .notes {
      grid-auto-columns: minmax(130px, 1fr);
    }
  }
</style>
