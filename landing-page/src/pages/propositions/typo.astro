---
import Layout from "../../layouts/Layout.astro";
import Choice from "../../components/studio/Choice.astro";
import "../../styles/composants.css";

const FONTS =
  "https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=EB+Garamond:ital,wght@1,500&family=Fraunces:ital,opsz,wght@1,9..144,500&family=JetBrains+Mono:wght@600&display=swap";

const variants = [
  {
    id: "actuelle",
    name: "Serif italique, aujourd'hui",
    note: "Instrument Serif italique, en orange.",
    current: true,
  },
  {
    id: "couleur",
    name: "Même police, en orange",
    note: "Le mot garde la grosse graisse du titre. Seule la couleur change.",
  },
  {
    id: "noir",
    name: "Tout noir, l'onde seule",
    note: "Aucun mot coloré : l'onde orange sous « voix » fait l'accent.",
  },
  {
    id: "capsule",
    name: "Le mot en cours de transcription",
    note: "Fond orange, texte blanc, comme le mot qui s'allume dans la capsule.",
  },
  {
    id: "marqueur",
    name: "Surligneur",
    note: "Un trait de marqueur clair derrière le mot, comme Granola.",
  },
  {
    id: "deuxtons",
    name: "Deux tons",
    note: "Le début en gris, « voix » en noir, comme Wispr Flow.",
  },
  {
    id: "leger",
    name: "Contraste de graisse",
    note: "Même police, « voix » en fin et en orange.",
  },
  {
    id: "romaine",
    name: "Serif droite",
    note: "Instrument Serif sans italique.",
  },
  {
    id: "fraunces",
    name: "Serif ronde italique",
    note: "Fraunces : courbes plus douces, tendance 2026.",
  },
  {
    id: "garamond",
    name: "Garamond italique",
    note: "EB Garamond, plus littéraire, proche de Wispr Flow.",
  },
  {
    id: "mono",
    name: "Machine à écrire",
    note: "JetBrains Mono : le mot tapé, comme une transcription.",
  },
  {
    id: "main",
    name: "Écrit à la main",
    note: "Caveat : une note griffonnée.",
  },
  {
    id: "contour",
    name: "Contour",
    note: "Lettres creuses, bord orange.",
  },
];
---

<Layout lang="fr">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={FONTS} />
  <main class="opts">
    <h1>Remplacer l'italique</h1>
    <p class="opts-intro">
      Chaque carte montre le titre du haut et celui du bloc orange. Coche ce
      que tu veux garder, puis copie tes choix en bas.
    </p>

    <section>
      <div class="opts-grid wide">
        {
          variants.map((v) => (
            <Choice group="Accent" name={v.name} current={v.current}>
              <div class={`typo t-${v.id}`}>
                <p class="hero-line">
                  À portée de{" "}
                  <span class="word">
                    voix
                    <canvas data-wave="sine" data-speed="0.7" aria-hidden="true" />
                  </span>
                </p>
                <p class="orange-line">
                  Du dire <span class="word">au faire</span>
                </p>
                <p class="note">{v.note}</p>
              </div>
            </Choice>
          ))
        }
      </div>
    </section>
  </main>

  <div class="opts-bar">
    <p data-count>Aucun choix</p>
    <button class="btn-primary" type="button" data-copy>Copier mes choix</button>
  </div>

  <script>
    const boxes = [...document.querySelectorAll<HTMLInputElement>("[data-keep]")];
    const count = document.querySelector<HTMLElement>("[data-count]");
    const kept = (): string[] =>
      boxes.filter((box) => box.checked).map((box) => box.dataset.keep ?? "");

    for (const box of boxes) {
      box.addEventListener("change", () => {
        const total = kept().length;
        if (count) count.textContent = total ? `${total} choix cochés` : "Aucun choix";
      });
    }

    document.querySelector("[data-copy]")?.addEventListener("click", () => {
      navigator.clipboard?.writeText(kept().join("\n"));
      if (count) count.textContent = "Choix copiés";
    });
  </script>
</Layout>

<style>
  .typo {
    display: grid;
    gap: 16px;
  }

  .hero-line {
    font-size: clamp(40px, 4.6vw, 64px);
    font-weight: 760;
    line-height: 1;
    letter-spacing: -0.035em;
    color: black;
  }

  .orange-line {
    padding: 18px 20px;
    border-radius: 14px;
    background: var(--gradient);
    color: white;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .note {
    font-size: 14.5px;
  }

  .word {
    position: relative;
    display: inline-block;
  }

  .hero-line canvas {
    position: absolute;
    bottom: -0.16em;
    left: -2%;
    width: 104%;
    height: 0.2em;
  }

  .t-actuelle .word {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
  }

  .t-actuelle .hero-line .word,
  .t-couleur .hero-line .word,
  .t-leger .hero-line .word,
  .t-romaine .hero-line .word,
  .t-fraunces .hero-line .word,
  .t-garamond .hero-line .word,
  .t-mono .hero-line .word,
  .t-main .hero-line .word {
    color: var(--orange-dark);
  }

  .t-capsule .word {
    padding: 0 0.12em 0.04em;
    border-radius: 0.14em;
    background: var(--orange-dark);
    color: white;
  }

  .t-capsule .orange-line .word {
    background: white;
    color: var(--orange-dark);
  }

  .t-capsule canvas,
  .t-marqueur canvas,
  .t-deuxtons canvas,
  .t-contour canvas {
    display: none;
  }

  .t-marqueur .word {
    z-index: 0;
  }

  .t-marqueur .word::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0.42em -0.08em 0.02em;
    border-radius: 0.08em;
    background: var(--orange-100);
    transform: rotate(-1.2deg);
  }

  .t-marqueur .orange-line .word::before {
    background: rgba(255, 255, 255, 0.28);
  }

  .t-deuxtons .hero-line {
    color: rgba(0, 0, 0, 0.36);
  }

  .t-deuxtons .hero-line .word {
    color: black;
  }

  .t-deuxtons .orange-line {
    color: rgba(255, 255, 255, 0.62);
  }

  .t-deuxtons .orange-line .word {
    color: white;
  }

  .t-leger .word {
    font-weight: 400;
  }

  .t-romaine .word {
    font-family: var(--serif);
    font-weight: 400;
  }

  .t-fraunces .word {
    font-family: "Fraunces", serif;
    font-style: italic;
    font-weight: 500;
  }

  .t-garamond .word {
    font-family: "EB Garamond", serif;
    font-style: italic;
    font-weight: 500;
  }

  .t-mono .word {
    font-family: "JetBrains Mono", monospace;
    font-weight: 600;
    letter-spacing: -0.06em;
  }

  .t-main .word {
    font-family: "Caveat", cursive;
    font-weight: 600;
    letter-spacing: 0;
  }

  .t-contour .word {
    color: transparent;
    -webkit-text-stroke: 0.035em var(--orange-dark);
  }

  .t-contour .orange-line .word {
    -webkit-text-stroke-color: white;
  }
</style>
