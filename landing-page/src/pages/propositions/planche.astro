---
import Clip from "../../components/Clip.astro";
import Phone from "../../components/Phone.astro";
import StageVideo from "../../components/StageVideo.astro";
import Ticket from "../../components/Ticket.astro";
import Fonts from "../../components/propositions/Fonts.astro";
import { appStoreUrl, bookingUrl, macDownloadUrl } from "../../lib/links";
import { moments, offers, trust } from "./_copy";
import "../../styles/tokens.css";

const store = appStoreUrl("fr");
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Proposition - La planche</title>
    <Fonts />
  </head>
  <body>
    <header class="sheet hero">
      <nav>
        <a class="brand" href="/fr/">FlowFlow</a>
        <a class="pill" href={store}>Télécharger</a>
      </nav>
      <div class="hero-grid">
        <div class="copy">
          <h1>À portée de <span>voix</span></h1>
          <p class="sub">Parle, FlowFlow exécute.</p>
          <div class="ctas">
            <a class="btn-primary" href={store}>App Store</a>
            <a class="pill big" href={macDownloadUrl}>Mac</a>
          </div>
        </div>
        <div class="scene" data-stage data-lang="fr">
          <div class="device" data-device data-format="story">
            <Phone><StageVideo lang="fr" /></Phone>
          </div>
          <div class="mascot" data-eyes aria-hidden="true">
            <img src="/brand/mascot-sticker.webp" alt="" width="760" height="760" />
            <i class="eye l"><b></b></i>
            <i class="eye r"><b></b></i>
          </div>
          <span class="tag t1">Décision · 10:15</span>
          <span class="tag t2">2 sources</span>
          <span class="tag t3">Rappel · jeudi 9 h</span>
        </div>
      </div>
    </header>

    <section class="sheet day">
      <h2>Une journée en quatre phrases.</h2>
      {
        moments.map((m, i) => (
          <article class:list={["moment", { flip: i % 2 }]}>
            <div class="words">
              <p class="hour">{m.hour}</p>
              <blockquote>{m.said}</blockquote>
              <p class="does">{m.does}</p>
            </div>
            <Phone>
              <Clip lang="fr" clip={m.clip} label={m.label} />
            </Phone>
          </article>
        ))
      }
    </section>

    <section class="sheet teams">
      <h2>{offers.title}</h2>
      <p class="lead">{offers.text}</p>
      <div class="tickets">
        <Ticket
          tone="paper"
          title={offers.solo.name}
          body={offers.solo.text}
          points={["iPhone et Mac", "Tes clés", "Open source"]}
          stub={offers.solo.stub}
          cta={offers.solo.cta}
          href={store}
        />
        <Ticket
          tone="orange"
          title={offers.guided.name}
          body={offers.guided.text}
          points={[
            "Espaces et partage",
            "Agents vérifiés et connecteurs",
            "Chaque action attend ton accord",
          ]}
          stub={offers.guided.stub}
          cta={offers.guided.cta}
          href={bookingUrl}
        />
      </div>
    </section>

    <section class="sheet end">
      <div class="facts">
        <p>{trust.stay}</p>
        <p>{trust.leave}</p>
        <p>{trust.cost}</p>
      </div>
      <h2>Aussitôt dit, aussitôt fait.</h2>
      <a class="pill big" href={store}>Télécharger sur l'App Store</a>
    </section>

    <script>
      import "../../scripts/mascotEyes.ts";
    </script>

    <style is:global>
      * {
        box-sizing: border-box;
      }

      :root {
        --cobalt: #1f3bff;
        --butter: #ffe500;
        --brand: #ff5c00;
        --char: #000000;
      }

      body {
        margin: 0;
        padding: 10px;
        background: var(--char);
        color: white;
        font-family: Switzer, system-ui, sans-serif;
        font-size: 18px;
        line-height: 1.45;
        -webkit-font-smoothing: antialiased;
      }

      h1,
      h2,
      h3 {
        margin: 0;
        font-family: Caprasimo, Georgia, serif;
        font-weight: 400;
        letter-spacing: -0.01em;
        text-wrap: balance;
      }

      .sheet {
        position: relative;
        overflow: hidden;
        margin-bottom: 10px;
        padding: clamp(20px, 3vw, 40px);
        border-radius: 30px;
      }

      .hero {
        min-height: calc(100svh - 20px);
        background: var(--cobalt);
      }

      nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .brand {
        font-family: Caprasimo, Georgia, serif;
        font-size: 28px;
        color: white;
        text-decoration: none;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 18px;
        border-radius: 12px;
        background: white;
        color: var(--char);
        font-weight: 600;
        text-decoration: none;
      }

      .pill.big {
        min-height: 54px;
        padding: 0 26px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
        align-items: center;
        gap: 20px;
        min-height: calc(100svh - 130px);
      }

      h1 {
        font-size: clamp(64px, 10.4vw, 176px);
        line-height: 0.96;
      }

      h1 span {
        color: var(--butter);
      }

      .sub {
        margin: 22px 0 26px;
        font-size: 26px;
        font-weight: 500;
      }

      .ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .btn-primary {
        display: inline-flex;
        align-items: center;
        min-height: 54px;
        padding: 0 28px;
        border-radius: 14px;
        background: var(--brand);
        color: white;
        font-weight: 700;
        text-decoration: none;
      }

      .scene {
        --phone-base: min(29vh, 20vw);
        position: relative;
        display: grid;
        place-items: center;
      }

      .device {
        --phone-width: calc(var(--phone-base) * 1.2219);
        rotate: 3deg;
      }

      .device .phone {
        height: calc(var(--phone-base) * 2.1722);
        aspect-ratio: auto;
        outline: 9px solid white;
      }

      .mascot {
        position: absolute;
        left: -9%;
        bottom: -10%;
        width: 44%;
        aspect-ratio: 1;
        rotate: -9deg;
        animation: bob 5s ease-in-out infinite;
      }

      .mascot img {
        width: 100%;
        height: 100%;
      }

      .eye {
        position: absolute;
        top: 40.1%;
        width: 20.4%;
        aspect-ratio: 1;
        border-radius: 50%;
        background: radial-gradient(circle at 42% 34%, #fff 52%, #dcd9dd 100%);
      }

      .eye.l {
        left: 29.6%;
      }

      .eye.r {
        left: 50.2%;
      }

      .eye b {
        position: absolute;
        top: 24%;
        left: 24%;
        width: 52%;
        height: 52%;
        border-radius: 50%;
        background: radial-gradient(
          circle,
          #0c0806 33%,
          #6b3a1b 36%,
          #9a5a2a 66%,
          #4d2810 100%
        );
        transform: translate(var(--x, 0), var(--y, 0));
      }

      .eye b::after {
        content: "";
        position: absolute;
        top: 18%;
        left: 56%;
        width: 26%;
        height: 26%;
        border-radius: 50%;
        background: white;
      }

      .tag {
        position: absolute;
        padding: 10px 14px;
        border: 5px solid white;
        border-radius: 14px;
        background: var(--butter);
        color: var(--char);
        font-size: 15px;
        font-weight: 700;
        white-space: nowrap;
      }

      .t1 {
        top: 12%;
        right: 2%;
        rotate: 5deg;
      }

      .t2 {
        top: 44%;
        right: -2%;
        rotate: -4deg;
        background: white;
      }

      .t3 {
        bottom: 12%;
        right: 6%;
        rotate: 3deg;
        background: var(--brand);
        color: white;
      }

      .day {
        background: var(--butter);
        color: var(--char);
      }

      .day > h2,
      .teams > h2 {
        max-width: 13ch;
        font-size: clamp(46px, 7.4vw, 124px);
        line-height: 1;
      }

      .moment {
        --phone-width: clamp(190px, 21vw, 300px);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(20px, 5vw, 80px);
        margin-top: 64px;
      }

      .moment.flip {
        flex-direction: row-reverse;
      }

      .words {
        max-width: 720px;
      }

      .hour {
        margin: 0 0 10px;
        font-size: 22px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
      }

      blockquote {
        position: relative;
        margin: 0;
        padding: 24px 28px;
        border-radius: 26px;
        background: white;
        font-family: Caprasimo, Georgia, serif;
        font-size: clamp(28px, 3.5vw, 54px);
        line-height: 1.08;
      }

      blockquote::after {
        content: "";
        position: absolute;
        bottom: -18px;
        left: 40px;
        width: 34px;
        height: 34px;
        background: white;
        clip-path: polygon(0 0, 100% 0, 18% 100%);
      }

      .does {
        margin: 34px 0 0;
        max-width: 480px;
        font-size: 19px;
      }

      .teams {
        background: #00c2ff;
        color: var(--char);
      }

      .lead {
        max-width: 620px;
        margin: 20px 0 0;
        font-size: 22px;
      }

      .tickets {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 26px;
        margin-top: 52px;
      }

      .end {
        padding-bottom: 64px;
        background: var(--brand);
        color: var(--char);
      }

      .end h2 {
        margin: 56px 0 26px;
        font-size: clamp(50px, 9vw, 150px);
        line-height: 0.98;
      }

      .facts {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
        font-size: 17px;
      }

      .facts p {
        margin: 0;
      }

      @keyframes bob {
        50% {
          translate: 0 -8px;
        }
      }

      @media (max-width: 860px) {
        .hero-grid,
        .tickets,
        .facts {
          grid-template-columns: 1fr;
        }

        .scene {
          --phone-base: min(21vh, 40vw);
          margin-top: 24px;
        }

        .tag {
          display: none;
        }

        .moment,
        .moment.flip {
          flex-direction: column;
          align-items: flex-start;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .mascot {
          animation: none;
        }
      }
    </style>
  </body>
</html>
