---
import Layout from "../../layouts/Layout.astro";
import Choice from "../../components/studio/Choice.astro";
import HeroShell from "../../components/studio/HeroShell.astro";
import SayToAction from "../../components/studio/SayToAction.astro";
import SpeedRace from "../../components/studio/SpeedRace.astro";
import TryVoice from "../../components/studio/TryVoice.astro";
import GreenLight from "../../components/studio/GreenLight.astro";
import "../../styles/retouches.css";
---

<Layout lang="fr">
  <main class="opts">
    <h1>Idées pour le haut de page</h1>
    <p class="opts-intro">
      Le premier écran, avec un seul ajout à la fois. La ligne pointillée marque
      le bas de l'écran à l'arrivée.
    </p>
    <div class="opts-grid one-col">
      <Choice group="Haut de page" name="Aujourd'hui" current>
        <HeroShell />
      </Choice>
      <Choice group="Haut de page" name="Parole vers action, avec Go">
        <HeroShell compact><SayToAction /></HeroShell>
      </Choice>
      <Choice group="Haut de page" name="Vitesse : 3 fois plus rapide que taper">
        <HeroShell compact><SpeedRace /></HeroShell>
      </Choice>
      <Choice group="Haut de page" name="Essaie avec ta voix">
        <HeroShell compact><TryVoice /></HeroShell>
      </Choice>
      <Choice group="Haut de page" name="Feu vert sur l'iPhone">
        <HeroShell compact><GreenLight /></HeroShell>
      </Choice>
      <Choice group="Haut de page" name="Titre dicté mot à mot">
        <HeroShell dictated />
      </Choice>
    </div>
  </main>

  <div class="opts-bar">
    <p data-count>Aucun choix</p>
    <button class="btn-primary" type="button" data-copy>Copier mes choix</button>
  </div>

  <script>
    const boxes = [...document.querySelectorAll<HTMLInputElement>("[data-keep]")];
    const count = document.querySelector<HTMLElement>("[data-count]");
    const kept = (): string[] =>
      boxes.filter((box) => box.checked).map((box) => box.dataset.keep ?? "");
    for (const box of boxes) {
      box.addEventListener("change", () => {
        const total = kept().length;
        if (count) count.textContent = total ? `${total} choix cochés` : "Aucun choix";
      });
    }
    document.querySelector("[data-copy]")?.addEventListener("click", () => {
      navigator.clipboard?.writeText(kept().join("\n"));
      if (count) count.textContent = "Choix copiés";
    });
  </script>
</Layout>
