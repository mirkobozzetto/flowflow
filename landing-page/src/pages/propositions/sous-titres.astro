---
import Clip from "../../components/Clip.astro";
import Phone from "../../components/Phone.astro";
import StageVideo from "../../components/StageVideo.astro";
import Fonts from "../../components/propositions/Fonts.astro";
import { appStoreUrl, bookingUrl, macDownloadUrl } from "../../lib/links";
import { moments, offers, trust } from "./_copy";

const store = appStoreUrl("fr");
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Proposition - Sous-titres</title>
    <Fonts />
  </head>
  <body>
    <nav>
      <a class="brand" href="/fr/">FlowFlow</a>
      <a href={store}>App Store</a>
      <a href={macDownloadUrl}>Mac</a>
    </nav>

    <div class="layout" data-stage data-lang="fr">
      <main>
        <header class="hero">
          <h1>À portée de voix</h1>
          <p>Parle, FlowFlow exécute.</p>
          <div class="ctas">
            <a href={store}>Télécharger sur l'App Store</a>
            <a class="alt" href={macDownloadUrl}>Pour Mac</a>
          </div>
          <Phone class="inline"><Clip lang="fr" clip="promo" /></Phone>
        </header>

        {
          moments.map((m) => (
            <section data-moment data-clip={m.clip}>
              <p class="time">{m.hour}</p>
              <p class="read" data-read>
                {m.said.split(" ").map((word) => (
                  <span>{word} </span>
                ))}
              </p>
              <p class="does">{m.does}</p>
              <Phone class="inline"><Clip lang="fr" clip={m.clip} /></Phone>
            </section>
          ))
        }
      </main>

      <aside>
        <div class="device" data-device data-format="story">
          <Phone><StageVideo lang="fr" /></Phone>
        </div>
      </aside>
    </div>

    <section class="plain">
      <h2>{offers.title}</h2>
      <div class="rows">
        <div>
          <h3>{offers.solo.name}</h3>
          <p>{offers.solo.text}</p>
          <a href={store}>{offers.solo.cta}</a>
          <small>{offers.solo.stub}</small>
        </div>
        <div>
          <h3>{offers.guided.name}</h3>
          <p>{offers.guided.text}</p>
          <a href={bookingUrl}>{offers.guided.cta}</a>
          <small>{offers.guided.stub}</small>
        </div>
      </div>
      <div class="rows facts">
        <p>{trust.stay}</p>
        <p>{trust.leave}</p>
        <p>{trust.cost}</p>
      </div>
    </section>

    <script>
      const words = [
        ...document.querySelectorAll<HTMLElement>("[data-read] span"),
      ];
      const sections = document.querySelectorAll<HTMLElement>("[data-moment]");
      const video = document.querySelector<HTMLVideoElement>(
        "[data-stage-video]",
      );
      const device = document.querySelector<HTMLElement>("[data-device]");
      const sound = document.querySelector<HTMLElement>("[data-sound]");
      let clip = "promo";
      let ticking = false;

      const update = (): void => {
        ticking = false;
        const line = innerHeight * 0.62;
        let last: HTMLElement | undefined;
        for (const word of words) {
          word.classList.remove("now");
          const on = word.getBoundingClientRect().top < line;
          word.classList.toggle("on", on);
          if (on) last = word;
        }
        last?.classList.add("now");

        for (const section of sections) {
          const box = section.getBoundingClientRect();
          if (box.top > innerHeight * 0.5 || box.bottom < innerHeight * 0.5) {
            continue;
          }
          const next = section.dataset.clip;
          if (next && next !== clip && video) {
            clip = next;
            video.poster = `/videos/fr/${clip}.webp`;
            video.src = `/videos/fr/${clip}.mp4`;
            video.muted = true;
            video.play().catch(() => undefined);
            if (device) device.dataset.format = "screen";
            if (sound) sound.hidden = true;
          }
        }
      };

      addEventListener(
        "scroll",
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        },
        { passive: true },
      );
      update();
    </script>

    <style is:global>
      * {
        box-sizing: border-box;
      }

      :root {
        --brand: #ff5c00;
        --ink: #000000;
        --mute: #c9c9c6;
      }

      body {
        margin: 0;
        background: #fff;
        color: var(--ink);
        font-family: Switzer, system-ui, sans-serif;
        font-size: 18px;
        line-height: 1.4;
        -webkit-font-smoothing: antialiased;
      }

      h1,
      h2,
      h3 {
        margin: 0;
        font-weight: 600;
        letter-spacing: -0.045em;
        text-wrap: balance;
      }

      nav {
        position: fixed;
        z-index: 10;
        inset: 0 0 auto;
        display: flex;
        gap: 22px;
        align-items: center;
        padding: 18px clamp(18px, 3vw, 40px);
        background: rgba(255, 255, 255, 0.86);
        backdrop-filter: blur(12px);
        font-weight: 500;
      }

      nav a {
        color: var(--ink);
        text-decoration: none;
      }

      .brand {
        margin-right: auto;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: clamp(20px, 5vw, 80px);
        padding: 0 clamp(18px, 3vw, 40px);
      }

      .hero {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        min-height: 92svh;
        padding-bottom: 56px;
      }

      h1 {
        font-size: clamp(64px, 11.4vw, 210px);
        line-height: 0.88;
        letter-spacing: -0.058em;
      }

      .hero p {
        margin: 26px 0 0;
        font-size: clamp(24px, 2.6vw, 38px);
        font-weight: 500;
        letter-spacing: -0.025em;
      }

      .inline {
        display: none !important;
      }

      .ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 24px;
      }

      .ctas a {
        padding: 15px 22px;
        background: var(--brand);
        color: white;
        font-weight: 600;
        text-decoration: none;
      }

      .ctas a.alt {
        background: var(--ink);
      }

      section[data-moment] {
        padding: 18vh 0;
        border-top: 1px solid var(--ink);
      }

      .time {
        margin: 12px 0 28px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
      }

      .read {
        margin: 0;
        font-size: clamp(40px, 6.4vw, 112px);
        font-weight: 600;
        line-height: 1.02;
        letter-spacing: -0.04em;
      }

      .read span {
        color: var(--mute);
        transition: color 0.2s ease;
      }

      .read span.on {
        color: var(--ink);
      }

      .read span.now {
        background: var(--brand);
        color: white;
      }

      .does {
        max-width: 520px;
        margin: 28px 0 0;
        font-size: 21px;
      }

      aside {
        --phone-base: min(29vh, 20vw);
        position: sticky;
        top: 0;
        display: grid;
        align-items: center;
        height: 100svh;
      }

      .device {
        --phone-width: var(--phone-base);
      }

      .device[data-format="story"] {
        --phone-width: calc(var(--phone-base) * 1.2219);
      }

      .device .phone {
        height: calc(var(--phone-base) * 2.1722);
        aspect-ratio: auto;
        background: var(--ink);
        box-shadow: none;
        transition: width 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      .plain {
        padding: 120px clamp(18px, 3vw, 40px) 90px;
        background: var(--ink);
        color: white;
      }

      .plain h2 {
        max-width: 14ch;
        font-size: clamp(46px, 8vw, 140px);
        line-height: 0.94;
        letter-spacing: -0.05em;
      }

      .rows {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        margin-top: 64px;
      }

      .rows h3 {
        font-size: 36px;
      }

      .rows a {
        display: inline-block;
        margin-top: 8px;
        padding: 14px 22px;
        background: var(--brand);
        color: white;
        font-weight: 600;
        text-decoration: none;
      }

      .rows small {
        display: block;
        margin-top: 10px;
        font-size: 15px;
      }

      .facts {
        grid-template-columns: repeat(3, 1fr);
        color: #b9b9b6;
      }

      @media (max-width: 860px) {
        .layout {
          grid-template-columns: 1fr;
        }

        aside {
          display: none;
        }

        .hero {
          justify-content: flex-start;
          min-height: 0;
          padding-top: 104px;
        }

        section[data-moment] {
          padding: 56px 0;
        }

        .inline {
          --phone-width: 62vw;
          display: block !important;
          margin: 32px auto 0;
        }

        .rows,
        .facts {
          grid-template-columns: 1fr;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .read span {
          color: var(--ink);
          transition: none;
        }

        .device .phone {
          transition: none;
        }
      }
    </style>
  </body>
</html>
