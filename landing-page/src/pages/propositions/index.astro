---
import Fonts from "../../components/propositions/Fonts.astro";
import { presets } from "../../components/studio/options";

const drafts = [
  {
    href: "/propositions/journee",
    image: "/propositions/journee.png",
    name: "1. La journée",
    idea: "Le téléphone reste fixe. La couleur et l'heure changent à chaque moment.",
    type: "Young Serif et Switzer",
    color: "Orange, jaune, cyan, cobalt, violet",
    risk: "Une page très colorée.",
  },
  {
    href: "/propositions/planche",
    image: "/propositions/planche.png",
    name: "2. La planche",
    idea: "La mascotte devient la star, ses yeux suivent la souris. Tout est un autocollant.",
    type: "Caprasimo et Switzer",
    color: "Cobalt, jaune, cyan, orange",
    risk: "Plus joueur, peut sembler moins sérieux.",
  },
  {
    href: "/propositions/sous-titres",
    image: "/propositions/sous-titres.png",
    name: "3. Sous-titres",
    idea: "La page se lit comme ta voix transcrite : les mots s'allument en défilant.",
    type: "Switzer seule, très grande",
    color: "Blanc pur, noir pur, orange vif",
    risk: "Le plus sobre, moins de couleurs.",
  },
];

const removed = [
  ["Un mot en italique serif dans chaque titre", "https://www.honterstudio.com/insights/make-website-look-less-ai-generated", "Honter Studio"],
  ["Fond crème et orange rouille", "https://kylechayka.substack.com/p/the-generic-style-of-ai-web-design", "Kyle Chayka"],
  ["Petits libellés en majuscules au-dessus des titres", "https://innestidigital.it/en/risorse/riconoscere-design-ai-generico-pmi", "Innesti"],
  ["Bandeau de texte qui défile", "https://innestidigital.it/en/risorse/riconoscere-design-ai-generico-pmi", "Innesti"],
  ["Halos, dégradés et ombres floues", "https://www.honterstudio.com/insights/make-website-look-less-ai-generated", "Honter Studio"],
  ["Le même fondu sur chaque bloc", "https://capitalandcompute.net/blog/fix-ai-slop-design/", "Capital & Compute"],
  ["Les slogans en deux moitiés", "https://demander.to/resources/ai-tells-in-copy/", "Demander"],
];

const added = [
  ["Le téléphone fixe, l'heure en grand derrière", "https://dokle.design/awards/grail-app-landing-page-keeps-the-phone-still", "Grail, site du jour Awwwards, 4 nov. 2026"],
  ["Deux couleurs par moment de la journée", "https://dokle.design/awards/brandon-yasin-portfolio-colour-changes-with-the-clock", "Brandon Yasin, site du jour Awwwards, 24 oct. 2026"],
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Propositions FlowFlow</title>
    <Fonts />
  </head>
  <body>
    <h1>Douze drafts. Coche ce que tu aimes.</h1>
    <p class="intro">
      Clique sur une image pour ouvrir le draft. Le panneau à droite change
      chaque option en direct.
    </p>
    <div class="drafts">
      {
        presets.map((preset) => (
          <article>
            <a href={`/propositions/studio#${preset.id}`}>
              <img
                src={`/propositions/drafts/${preset.id}.webp`}
                alt={preset.name}
                width="480"
                height="1200"
                loading="lazy"
              />
            </a>
            <label>
              <input type="checkbox" data-like={preset.name} />
              {preset.name}
            </label>
          </article>
        ))
      }
    </div>
    <p class="actions">
      <button type="button" data-copy-likes>Copier mes choix</button>
      <a href="/propositions/studio">Ouvrir le panneau d'options</a>
    </p>
    <textarea data-likes rows="3" readonly aria-label="Mes choix"></textarea>

    <h2 class="older">Les trois premières idées, gardées</h2>
    <div class="grid">
      {
        drafts.map((d) => (
          <a class="card" href={d.href}>
            <img src={d.image} alt={d.name} width="1440" height="900" />
            <h2>{d.name}</h2>
            <p>{d.idea}</p>
            <dl>
              <dt>Typo</dt>
              <dd>{d.type}</dd>
              <dt>Couleurs</dt>
              <dd>{d.color}</dd>
              <dt>Risque</dt>
              <dd>{d.risk}</dd>
            </dl>
          </a>
        ))
      }
    </div>

    <div class="cols">
      <section>
        <h2>Ce qui saute dans les trois</h2>
        <ul>
          {
            removed.map(([what, url, source]) => (
              <li>
                {what}. <a href={url}>{source}</a>
              </li>
            ))
          }
        </ul>
      </section>
      <section>
        <h2>Ce qui arrive</h2>
        <ul>
          <li>La mascotte détourée, en très grand.</li>
          <li>Les titres deviennent de vraies phrases parlées, celles des vidéos.</li>
          {
            added.map(([what, url, source]) => (
              <li>
                {what}. <a href={url}>{source}</a>
              </li>
            ))
          }
        </ul>
        <h2 class="next">Ce qui reste</h2>
        <ul>
          <li>« À portée de voix » et « Parle, FlowFlow exécute ».</li>
          <li>La promo, les clips, les quatre moments.</li>
          <li>Les deux offres, ce qui reste et ce qui sort, le coût, la FAQ.</li>
        </ul>
      </section>
    </div>

    <script>
      const output = document.querySelector<HTMLTextAreaElement>("[data-likes]");
      const refresh = (): void => {
        const liked = [
          ...document.querySelectorAll<HTMLInputElement>("[data-like]:checked"),
        ].map((input) => input.dataset.like);
        if (output) output.value = liked.join("\n");
      };
      for (const input of document.querySelectorAll("[data-like]")) {
        input.addEventListener("change", refresh);
      }
      document
        .querySelector("[data-copy-likes]")
        ?.addEventListener("click", () => {
          refresh();
          if (output) navigator.clipboard?.writeText(output.value);
        });
    </script>

    <style is:global>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: clamp(18px, 3vw, 40px);
        background: #fff;
        color: #000;
        font-family: Switzer, system-ui, sans-serif;
        font-size: 17px;
        line-height: 1.4;
      }

      h1 {
        margin: 0 0 28px;
        font-size: clamp(34px, 5vw, 72px);
        font-weight: 600;
        line-height: 1;
        letter-spacing: -0.04em;
      }

      h2 {
        margin: 0;
        font-size: 26px;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      .intro {
        margin: -14px 0 24px;
        font-size: 19px;
      }

      .drafts {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
      }

      .drafts img {
        display: block;
        width: 100%;
        height: auto;
        border: 2px solid #000;
      }

      .drafts a:hover img {
        border-color: #ff5c00;
      }

      .drafts label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-top: 8px;
        font-weight: 600;
        cursor: pointer;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        margin: 26px 0 8px;
      }

      .actions button {
        min-height: 48px;
        padding: 0 22px;
        border: none;
        border-radius: 8px;
        background: #ff5c00;
        color: #000;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }

      textarea {
        width: 100%;
        max-width: 560px;
        border: 2px solid #000;
        border-radius: 8px;
        font: inherit;
      }

      .older {
        margin: 56px 0 18px;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }

      .card {
        color: inherit;
        text-decoration: none;
      }

      .card img {
        display: block;
        width: 100%;
        height: auto;
        margin-bottom: 12px;
        border: 2px solid #000;
      }

      .card:hover h2 {
        color: #ff5c00;
      }

      .card p {
        margin: 6px 0 10px;
      }

      dl {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 2px 12px;
        margin: 0;
        font-size: 15px;
      }

      dt {
        font-weight: 600;
      }

      dd {
        margin: 0;
      }

      .cols {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        margin-top: 44px;
        padding-top: 20px;
        border-top: 2px solid #000;
      }

      ul {
        margin: 12px 0 0;
        padding-left: 18px;
      }

      li {
        margin-bottom: 5px;
      }

      a {
        color: #1f3bff;
      }

      .next {
        margin-top: 26px;
      }

      @media (max-width: 860px) {
        .grid,
        .cols {
          grid-template-columns: 1fr;
        }

        .drafts {
          grid-template-columns: 1fr 1fr;
        }
      }
    </style>
  </body>
</html>
