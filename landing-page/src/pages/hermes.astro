---
import HermesLink from "../components/hermes/HermesLink.astro";
import Layout from "../layouts/Layout.astro";
import { section } from "../lib/i18n";
import { hermesUrl } from "../lib/links";

const { meta } = section("en", "hermes").link;
---

<Layout lang="en" path={hermesUrl} noindex {...meta}>
  <HermesLink lang="en" />
</Layout>
