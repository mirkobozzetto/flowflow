# These reach the binary at compile time in DEBUG builds only (`make all`,
# `make dev`, `make ddev`): your own device works without typing anything.
# A RELEASE build (`make appstore`, `make desktop-app`) deliberately drops
# them, so a tester or an App Store user never receives your keys and never
# bills against them. There, keys come from Settings or the runtime
# environment. See src/build_env.rs.
SONIOX_API_KEY=your_soniox_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# APPLE_TEAM_ID is ONLY required for `make appstore` (paid Apple Developer
# Program). Free users running `make dev`, `make ddev`, or `make all` rely on
# Xcode auto-provisioning (Personal Team, 7-day profiles) and do NOT need this.
# Paid users: find your Team ID at https://developer.apple.com/account → Membership.
APPLE_TEAM_ID=

# Optional: enables `make appstore` to run `xcrun altool --validate-app`
# server-side against Apple after the IPA is built. If either is missing,
# validation is skipped and you can still upload via Transporter manually.
# APPLE_ID = your Apple ID email used for App Store Connect.
# APP_SPEC_PASSWORD = app-specific password from
#   https://account.apple.com → Sign-In and Security → App-Specific Passwords.
#   Treat like a secret. You can revoke + regenerate freely whenever needed.
APPLE_ID=
APP_SPEC_PASSWORD=
