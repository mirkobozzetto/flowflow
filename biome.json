{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "root": true,
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "files": {
    "includes": [
      "landing-page/**",
      "!**/node_modules",
      "!**/dist",
      "!**/.astro",
      "!**/*.astro",
      "!**/reference"
    ]
  }
}
